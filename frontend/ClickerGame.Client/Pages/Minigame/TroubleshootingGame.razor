@code {
    [Parameter] public Gig? CurrentGig { get; set; }
    [Parameter] public float PlayerStamina { get; set; } = 100f;
    [Parameter] public EventCallback<MinigameResult> OnComplete { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private ElementReference gameContainerRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await gameContainerRef.FocusAsync(); } catch { }
        }
    }

    // Tutorial state
    private bool showTutorial = true;
    private int tutorialStep = 0;

    private void OpenTutorial()
    {
        showTutorial = true;
        tutorialStep = 0;
    }

    private void CloseTutorial()
    {
        showTutorial = false;
        try { _ = gameContainerRef.FocusAsync(); } catch { }
    }

    private void NextTutorialStep()
    {
        if (tutorialStep < 1) tutorialStep++;
    }

    private void PrevTutorialStep()
    {
        if (tutorialStep > 0) tutorialStep--;
    }

    private string GetTutorialStepTitle(int step) => step switch
    {
        0 => "1. RENTO JA HELPPO VIANHAKU",
        _ => "2. KORJAUS & NÄPPÄIMET"
    };

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (showTutorial)
        {
            if (e.Key is " " or "Enter")
            {
                if (tutorialStep < 1) tutorialStep++;
                else CloseTutorial();
            }
            else if (e.Key is "Escape")
            {
                CloseTutorial();
            }
            return;
        }

        if (isGameOver)
        {
            if (e.Key is " " or "Enter")
            {
                _ = SubmitResult();
            }
            return;
        }

        var key = e.Key.ToLowerInvariant();
        if (key is " " or "enter")
        {
            AutofindFault();
        }
        else if (key is "1")
        {
            AttemptFix("FUSE");
        }
        else if (key is "2")
        {
            AttemptFix("ESTOP");
        }
        else if (key is "3")
        {
            AttemptFix("THERMAL");
        }
        else if (key is "4")
        {
            AttemptFix("PSU");
        }
        else if (key is "5")
        {
            AttemptFix("CONTACTOR");
        }
        else if (key is "escape")
        {
            _ = AbortGame();
        }
    }

    private void AutofindFault()
    {
        measurementsTaken++;
        // Auto-probe the exact faulty test point and display helpful arcade hint
        string targetTp = currentFault.FaultType switch
        {
            "FUSE" => "TP2",
            "ESTOP" => "TP5",
            "THERMAL" => "TP6",
            "PSU" => "TP4",
            _ => "TP7"
        };
        redProbePoint = targetTp;
        blackProbePoint = (currentFault.FaultType == "PSU" || currentFault.FaultType == "ESTOP" || currentFault.FaultType == "THERMAL" || currentFault.FaultType == "CONTACTOR") ? "TP8" : "GND";
        UpdateMultimeterDisplay();
        
        string fixName = currentFault.FaultType switch
        {
            "FUSE" => "1. Sulake F1",
            "ESTOP" => "2. Hätä-seis S0",
            "THERMAL" => "3. Lämpörele F2",
            "PSU" => "4. Teholähde 24V",
            _ => "5. Kontaktori K1"
        };
        actionFeedback = $"🔍 PIKADIAGNOOSI: Mittapää osui vikaan kohteessa {targetTp}! Vika näyttää olevan: {currentFault.FaultTitle}. Paina [{fixName[0]}] korjataksesi!";
        try { JS.InvokeVoidAsync("GameAudio.playTick"); } catch { }
    }

    public record IndustrialFault(
        string FaultType,
        string FaultTitle,
        string CustomerReport,
        string BrokenComponentId
    );

    private List<IndustrialFault> potentialFaults = new()
    {
        new("FUSE", "Palanut sulake F1 (vaihe L2 poikki)", "Moottori jurahtaa muttei pyöri, pääkeskukselta kuuluu surinaa.", "F1"),
        new("ESTOP", "Jumittunut hätä-seis S0", "Ohjausjännite puuttuu kokonaan, laite ei reagoi käynnistysnappiin.", "S0"),
        new("THERMAL", "Lauennut lämpörele F2 (95-96 auki)", "Pumppu pysähtyi kuormituksessa, lämpöreleen punainen indikaattori ylhäällä.", "F2"),
        new("PSU", "Viallinen 24VDC Teholähde T1", "24V ohjausjännite on 0V, merkkivalot pimeänä.", "PSU"),
        new("CONTACTOR", "Kontaktori K1 kelakatkos (A1-A2 poikki)", "Käynnistysnappia painettaessa ohjausjännite tulee kelalle, mutta kontaktori ei vedä.", "K1")
    };

    private IndustrialFault currentFault = default!;

    // Multimeter State
    private string currentMode = "V AC"; // OFF, V AC, V DC, OHM, CONT
    private string displayValue = "0.0";
    private string displayUnit = "V~";

    private string? redProbePoint = null;
    private string? blackProbePoint = null;
    private int measurementsTaken = 0;
    private int wrongFixCount = 0;
    private bool isSolved = false;
    private string actionFeedback = "";
    private bool isGameOver = false;
    private MinigameResult? finalResult;

    protected override void OnInitialized()
    {
        // Randomize fault
        var rng = new Random();
        currentFault = potentialFaults[rng.Next(potentialFaults.Count)];
        UpdateMultimeterDisplay();
    }

    private void CycleMode()
    {
        currentMode = currentMode switch
        {
            "OFF" => "V AC",
            "V AC" => "V DC",
            "V DC" => "OHM",
            "OHM" => "CONT",
            _ => "OFF"
        };
        try { JS.InvokeVoidAsync("GameAudio.playTick"); } catch { }
        UpdateMultimeterDisplay();
    }

    private string GetKnobClass() => currentMode switch
    {
        "OFF" => "knob-pos-off",
        "V AC" => "knob-pos-vac",
        "V DC" => "knob-pos-vdc",
        "OHM" => "knob-pos-ohm",
        "CONT" => "knob-pos-cont",
        _ => "knob-pos-vac"
    };

    private void ProbePoint(string tp)
    {
        // Alternate probe placement
        if (blackProbePoint == null)
        {
            blackProbePoint = tp;
        }
        else if (redProbePoint == null)
        {
            redProbePoint = tp;
            measurementsTaken++;
        }
        else
        {
            // Move red probe, keep black probe as COM reference
            redProbePoint = tp;
            measurementsTaken++;
        }

        try { JS.InvokeVoidAsync("GameAudio.playTick"); } catch { }
        UpdateMultimeterDisplay();
    }

    private string GetTpClass(string tp)
    {
        if (redProbePoint == tp) return "probe-red";
        if (blackProbePoint == tp) return "probe-black";
        return "";
    }

    private void UpdateMultimeterDisplay()
    {
        if (currentMode == "OFF")
        {
            displayValue = "";
            displayUnit = "";
            return;
        }

        if (redProbePoint == null || blackProbePoint == null)
        {
            displayValue = currentMode == "OHM" ? "OL" : "0.0";
            displayUnit = currentMode switch { "V AC" => "V~", "V DC" => "V⎓", "OHM" => "MΩ", "CONT" => "Ω", _ => "" };
            return;
        }

        // Calculate authentic physical reading based on active fault
        string p1 = redProbePoint;
        string p2 = blackProbePoint;

        // Voltage AC check
        if (currentMode == "V AC")
        {
            displayUnit = "V~";
            if ((p1 == "TP1" && p2 == "GND") || (p1 == "GND" && p2 == "TP1") ||
                (p1 == "TP2" && p2 == "GND") || (p1 == "GND" && p2 == "TP2"))
            {
                displayValue = "231.4"; // Standard phase to ground
            }
            else if ((p1 == "TP3" && p2 == "GND") || (p1 == "GND" && p2 == "TP3"))
            {
                // If FUSE fault, phase voltage dropped
                displayValue = currentFault.FaultType == "FUSE" ? "0.8" : "230.9";
            }
            else if ((p1 == "TP4" && p2 == "GND") || (p1 == "GND" && p2 == "TP4"))
            {
                displayValue = (currentFault.FaultType == "FUSE" || currentFault.FaultType == "CONTACTOR") ? "0.0" : "230.5";
            }
            else
            {
                displayValue = "0.0";
            }
        }
        else if (currentMode == "V DC")
        {
            displayUnit = "V⎓";
            if ((p1 == "TP5" && p2 == "TP8") || (p1 == "TP8" && p2 == "TP5"))
            {
                displayValue = currentFault.FaultType == "PSU" ? "0.2" : "24.1";
            }
            else if ((p1 == "TP6" && p2 == "TP8") || (p1 == "TP8" && p2 == "TP6"))
            {
                // After E-STOP
                displayValue = (currentFault.FaultType == "PSU" || currentFault.FaultType == "ESTOP") ? "0.0" : "24.0";
            }
            else if ((p1 == "TP7" && p2 == "TP8") || (p1 == "TP8" && p2 == "TP7"))
            {
                // After Thermal relay
                displayValue = (currentFault.FaultType == "PSU" || currentFault.FaultType == "ESTOP" || currentFault.FaultType == "THERMAL") ? "0.0" : "24.0";
            }
            else
            {
                displayValue = "0.0";
            }
        }
        else if (currentMode == "OHM" || currentMode == "CONT")
        {
            displayUnit = currentMode == "OHM" ? "Ω" : "CONT";
            // Check continuity of specific components
            if ((p1 == "TP2" && p2 == "TP3") || (p1 == "TP3" && p2 == "TP2"))
            {
                // Sulake F1
                if (currentFault.FaultType == "FUSE")
                {
                    displayValue = "OL";
                }
                else
                {
                    displayValue = "0.2";
                    if (currentMode == "CONT") try { JS.InvokeVoidAsync("GameAudio.playTick"); } catch { }
                }
            }
            else if ((p1 == "TP5" && p2 == "TP6") || (p1 == "TP6" && p2 == "TP5"))
            {
                // E-stop S0
                if (currentFault.FaultType == "ESTOP")
                {
                    displayValue = "OL";
                }
                else
                {
                    displayValue = "0.4";
                    if (currentMode == "CONT") try { JS.InvokeVoidAsync("GameAudio.playTick"); } catch { }
                }
            }
            else if ((p1 == "TP6" && p2 == "TP7") || (p1 == "TP7" && p2 == "TP6"))
            {
                // Thermal relay F2
                if (currentFault.FaultType == "THERMAL")
                {
                    displayValue = "OL";
                }
                else
                {
                    displayValue = "0.3";
                    if (currentMode == "CONT") try { JS.InvokeVoidAsync("GameAudio.playTick"); } catch { }
                }
            }
            else
            {
                displayValue = "OL";
            }
        }
    }

    private void AttemptFix(string chosenFix)
    {
        if (isSolved) return;

        if (chosenFix == currentFault.FaultType)
        {
            isSolved = true;
            actionFeedback = $"✔ OIKEA KORJAUS! {currentFault.FaultTitle} korjattu. Linja käynnistyy ja moottori pyörii normaalisti!";
            try { JS.InvokeVoidAsync("GameAudio.playSuccess"); } catch { }

            _ = Task.Delay(1400).ContinueWith(_ =>
            {
                InvokeAsync(FinishGame);
            });
        }
        else
        {
            wrongFixCount++;
            actionFeedback = "⚠ VÄÄRÄ TOIMENPIDE! Vika ei poistunut, laitteisto ei vieläkään käynnisty. Jatka mittauksia!";
            try { JS.InvokeVoidAsync("GameAudio.playMiss"); } catch { }
        }
    }

    private void FinishGame()
    {
        isGameOver = true;
        float precision = Math.Clamp(100f - (wrongFixCount * 30f) - (measurementsTaken > 8 ? (measurementsTaken - 8) * 3f : 0f), 40f, 100f);
        string grade = precision >= 85f ? "perfect" : precision >= 60f ? "good" : "fail";

        double basePay = CurrentGig != null ? (CurrentGig.PayMin + CurrentGig.PayMax) / 2.0 : 280.0;
        double payout = grade switch
        {
            "perfect" => basePay * 1.25,
            "good" => basePay,
            _ => basePay * 0.4
        };

        int xp = grade switch
        {
            "perfect" => 140,
            "good" => 80,
            _ => 25
        };

        int repDelta = grade switch
        {
            "perfect" => 7,
            "good" => 2,
            _ => -6
        };

        finalResult = new MinigameResult(precision, grade, xp, repDelta, payout);
        StateHasChanged();
    }

    private Task SubmitResult() => finalResult != null ? OnComplete.InvokeAsync(finalResult) : Task.CompletedTask;
    private Task AbortGame() => OnCancel.InvokeAsync();
}
