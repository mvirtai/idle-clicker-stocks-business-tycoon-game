@namespace ClickerGame.Client.Components
@using ClickerGame.Client.Models
@inject IJSRuntime JS

<section class="luminous-panel luminous-panel-emerald p-4 md:p-5 flex flex-col gap-3.5 text-slate-100 relative overflow-hidden shadow-2xl">
    <!-- Ambient glowing light reflections -->
    <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -top-24 -right-24 w-72 h-72 bg-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Panel Header: Title + Category Tabs + Unlocked Count -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-emerald-500/30 pb-3 z-10">
        <div class="flex items-center gap-3">
            <span class="text-3xl filter drop-shadow-[0_0_12px_#10b981]">🚀</span>
            <div>
                <div class="text-[10px] font-mono text-emerald-400 font-black uppercase tracking-widest flex items-center gap-2">
                    <span>MODUULIKISKO // UPGRADE RACK</span>
                    <span class="text-slate-500">•</span>
                    <span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 font-bold border border-emerald-500/30">
                        AKTIIVISET: @GetUnlockedCount() / @(Upgrades.Count)
                    </span>
                </div>
                <div class="text-lg font-heading font-black text-white tracking-wide drop-shadow">
                    AVATUT PÄIVITYKSET & KALUSTO
                </div>
            </div>
        </div>

        <!-- Vibrant Category Filter Pills -->
        <div class="flex flex-wrap items-center gap-1.5 bg-slate-950/90 p-1.5 rounded-xl border border-white/10 text-xs font-mono shadow-inner">
            <button class="px-3 py-1.5 rounded-lg transition-all font-bold flex items-center gap-1 @(selectedCategory == "all" ? "bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 shadow-md shadow-emerald-500/40 scale-105" : "text-slate-400 hover:text-white")"
                    @onclick='() => selectedCategory = "all"'>
                <span>🌈 Kaikki</span>
                <span class="text-[10px] opacity-80">(@Upgrades.Count)</span>
            </button>
            <button class="px-3 py-1.5 rounded-lg transition-all font-bold flex items-center gap-1 @(selectedCategory == "tools" ? "bg-gradient-to-r from-cyan-400 to-blue-500 text-slate-950 shadow-md shadow-cyan-500/40 scale-105" : "text-slate-400 hover:text-cyan-300")"
                    @onclick='() => selectedCategory = "tools"'>
                <span>🔧 Työkalut</span>
            </button>
            <button class="px-3 py-1.5 rounded-lg transition-all font-bold flex items-center gap-1 @(selectedCategory == "certs" ? "bg-gradient-to-r from-amber-400 to-orange-500 text-slate-950 shadow-md shadow-amber-500/40 scale-105" : "text-slate-400 hover:text-amber-300")"
                    @onclick='() => selectedCategory = "certs"'>
                <span>📜 Luvat</span>
            </button>
            <button class="px-3 py-1.5 rounded-lg transition-all font-bold flex items-center gap-1 @(selectedCategory == "equipment" ? "bg-gradient-to-r from-purple-400 to-indigo-500 text-white shadow-md shadow-purple-500/40 scale-105" : "text-slate-400 hover:text-purple-300")"
                    @onclick='() => selectedCategory = "equipment"'>
                <span>🚐 Kalusto</span>
            </button>
            <button class="px-3 py-1.5 rounded-lg transition-all font-bold flex items-center gap-1 @(selectedCategory == "company" ? "bg-gradient-to-r from-pink-500 to-rose-600 text-white shadow-md shadow-pink-500/40 scale-105" : "text-slate-400 hover:text-pink-300")"
                    @onclick='() => selectedCategory = "company"'>
                <span>🏢 Yritys & Tiimi</span>
            </button>
        </div>
    </div>

    <!-- Upgrades Grid: Radiant Jewel Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3.5 z-10 max-h-[360px] overflow-y-auto pr-1">
        @foreach (var up in FilteredUpgrades)
        {
            var canAfford = PlayerCash >= up.CurrentCost && !up.IsMaxLevel;
            var isUnlocked = up.Level > 0;

            <div class="relative flex flex-col justify-between p-3.5 rounded-2xl transition-all duration-300 @GetCardBackground(up, isUnlocked) border @GetCardBorder(up, isUnlocked) shadow-xl hover:scale-[1.02] group">
                
                <!-- Card Header: Glowing Icon + Name + Level Pill -->
                <div>
                    <div class="flex items-start justify-between gap-2 mb-2">
                        <div class="w-10 h-10 rounded-xl flex items-center justify-center text-xl @GetIconContainerClass(up.Category) border @GetIconBorderClass(up.Category) shadow-md group-hover:rotate-6 transition-transform">
                            @up.Icon
                        </div>
                        <div class="text-right">
                            <span class="text-[10px] font-mono font-black px-2 py-0.5 rounded-full @(isUnlocked ? GetActiveBadgeClass(up.Category) : "bg-slate-900 text-slate-400 border border-slate-800")">
                                @(up.IsMaxLevel ? "MAX ⭐" : $"TASO {up.Level}/{up.MaxLevel}")
                            </span>
                        </div>
                    </div>

                    <h4 class="font-heading font-black text-sm text-white tracking-wide leading-snug group-hover:text-amber-200 transition-colors">
                        @up.Name
                    </h4>

                    <p class="text-[11px] text-slate-300 line-clamp-2 my-1.5 leading-relaxed">
                        @up.Description
                    </p>
                </div>

                <!-- Card Middle: Stat Benefits with Glowing Colored Values -->
                <div class="my-2 py-2 border-y border-white/10 text-[11px] font-mono space-y-1 bg-black/30 px-2 rounded-lg">
                    @if (up.ClickBonus > 0)
                    {
                        <div class="text-cyan-300 flex items-center justify-between">
                            <span class="flex items-center gap-1"><span>⚡</span> Klikkivoima:</span>
                            <span class="font-bold filter drop-shadow-[0_0_4px_#06b6d4]">+@(up.ClickBonus * Math.Max(1, up.Level)) €</span>
                        </div>
                    }
                    @if (up.PassiveIncomeBonus > 0)
                    {
                        <div class="text-emerald-300 flex items-center justify-between">
                            <span class="flex items-center gap-1"><span>⚙️</span> Automaatio:</span>
                            <span class="font-bold filter drop-shadow-[0_0_4px_#10b981]">+@(up.PassiveIncomeBonus * Math.Max(1, up.Level)) €/s</span>
                        </div>
                    }
                    @if (up.StaminaDrainReduction > 0)
                    {
                        <div class="text-amber-300 flex items-center justify-between">
                            <span class="flex items-center gap-1"><span>☕</span> Kestävyys:</span>
                            <span class="font-bold filter drop-shadow-[0_0_4px_#f59e0b]">-@(Math.Round(up.StaminaDrainReduction * 100))%</span>
                        </div>
                    }
                    @if (up.RepBonus > 0)
                    {
                        <div class="text-purple-300 flex items-center justify-between">
                            <span class="flex items-center gap-1"><span>⭐</span> Maine:</span>
                            <span class="font-bold filter drop-shadow-[0_0_4px_#a855f7]">+@up.RepBonus REP</span>
                        </div>
                    }
                </div>

                <!-- Card Footer: Shimmering Buy Button -->
                <div class="pt-1">
                    @if (up.IsMaxLevel)
                    {
                        <button class="w-full py-2 px-2.5 rounded-xl bg-emerald-950/60 border border-emerald-400/50 text-emerald-300 text-xs font-mono font-black cursor-default flex items-center justify-center gap-1.5 shadow-[0_0_12px_rgba(16,185,129,0.2)]">
                            <span>✓</span>
                            <span>TÄYSIN ASENNETTU</span>
                        </button>
                    }
                    else
                    {
                        <button class="w-full py-2 px-3 rounded-xl text-xs font-mono font-black uppercase transition-all flex items-center justify-between @(canAfford ? GetBuyButtonGradientClass(up.Category) : "bg-slate-900/90 border border-slate-800 text-slate-500 cursor-not-allowed")"
                                disabled="@(!canAfford)"
                                @onclick="() => HandleBuyUpgrade(up)">
                            <span class="flex items-center gap-1">
                                <span>@(up.Level == 0 ? "AVAA" : "PÄIVITÄ")</span>
                            </span>
                            <span class="font-mono font-black text-white drop-shadow">
                                @up.CurrentCost.ToString("N0", new System.Globalization.CultureInfo("fi-FI")) €
                            </span>
                        </button>
                    }
                </div>

            </div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public List<UpgradeItem> Upgrades { get; set; } = new();
    [Parameter, EditorRequired] public double PlayerCash { get; set; }
    [Parameter] public EventCallback<UpgradeItem> OnPurchaseUpgrade { get; set; }

    private string selectedCategory = "all";

    private IEnumerable<UpgradeItem> FilteredUpgrades => selectedCategory == "all"
        ? Upgrades
        : Upgrades.Where(u => u.Category == selectedCategory);

    private int GetUnlockedCount() => Upgrades.Count(u => u.Level > 0);

    private async Task HandleBuyUpgrade(UpgradeItem item)
    {
        try
        {
            await JS.InvokeVoidAsync("GameAudio.playUpgrade");
        }
        catch { }

        await OnPurchaseUpgrade.InvokeAsync(item);
    }

    private string GetCardBackground(UpgradeItem up, bool isUnlocked)
    {
        if (isUnlocked)
        {
            return up.Category switch
            {
                "tools" => "bg-gradient-to-b from-cyan-950/70 via-slate-900/95 to-slate-950/95",
                "certs" => "bg-gradient-to-b from-amber-950/70 via-slate-900/95 to-slate-950/95",
                "equipment" => "bg-gradient-to-b from-purple-950/70 via-slate-900/95 to-slate-950/95",
                "company" => "bg-gradient-to-b from-pink-950/70 via-slate-900/95 to-slate-950/95",
                _ => "bg-gradient-to-b from-emerald-950/70 via-slate-900/95 to-slate-950/95"
            };
        }
        return "bg-slate-950/80 opacity-85 hover:opacity-100";
    }

    private string GetCardBorder(UpgradeItem up, bool isUnlocked)
    {
        if (isUnlocked)
        {
            return up.Category switch
            {
                "tools" => "border-cyan-500/50 shadow-[0_0_18px_rgba(6,182,212,0.25)]",
                "certs" => "border-amber-500/50 shadow-[0_0_18px_rgba(245,158,11,0.25)]",
                "equipment" => "border-purple-500/50 shadow-[0_0_18px_rgba(168,85,247,0.25)]",
                "company" => "border-pink-500/50 shadow-[0_0_18px_rgba(236,72,153,0.25)]",
                _ => "border-emerald-500/50 shadow-[0_0_18px_rgba(16,185,129,0.25)]"
            };
        }
        return "border-slate-800/80 hover:border-slate-700";
    }

    private string GetIconContainerClass(string cat) => cat switch
    {
        "tools" => "bg-cyan-500/20 text-cyan-300",
        "certs" => "bg-amber-500/20 text-amber-300",
        "equipment" => "bg-purple-500/20 text-purple-300",
        "company" => "bg-pink-500/20 text-pink-300",
        _ => "bg-emerald-500/20 text-emerald-300"
    };

    private string GetIconBorderClass(string cat) => cat switch
    {
        "tools" => "border-cyan-500/40",
        "certs" => "border-amber-500/40",
        "equipment" => "border-purple-500/40",
        "company" => "border-pink-500/40",
        _ => "border-emerald-500/40"
    };

    private string GetActiveBadgeClass(string cat) => cat switch
    {
        "tools" => "bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 shadow-[0_0_8px_rgba(6,182,212,0.3)]",
        "certs" => "bg-amber-500/20 text-amber-300 border border-amber-500/40 shadow-[0_0_8px_rgba(245,158,11,0.3)]",
        "equipment" => "bg-purple-500/20 text-purple-300 border border-purple-500/40 shadow-[0_0_8px_rgba(168,85,247,0.3)]",
        "company" => "bg-pink-500/20 text-pink-300 border border-pink-500/40 shadow-[0_0_8px_rgba(236,72,153,0.3)]",
        _ => "bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-[0_0_8px_rgba(16,185,129,0.3)]"
    };

    private string GetBuyButtonGradientClass(string cat) => cat switch
    {
        "tools" => "bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 shadow-lg shadow-cyan-500/30 active:scale-95",
        "certs" => "bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 shadow-lg shadow-amber-500/30 active:scale-95",
        "equipment" => "bg-gradient-to-r from-purple-500 to-indigo-600 hover:from-purple-400 hover:to-indigo-500 text-white shadow-lg shadow-purple-500/30 active:scale-95",
        "company" => "bg-gradient-to-r from-pink-500 to-rose-600 hover:from-pink-400 hover:to-rose-500 text-white shadow-lg shadow-pink-500/30 active:scale-95",
        _ => "bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white shadow-lg shadow-emerald-500/30 active:scale-95"
    };
}
