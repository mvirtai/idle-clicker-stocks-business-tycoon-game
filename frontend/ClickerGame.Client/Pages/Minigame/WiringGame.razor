@namespace ClickerGame.Client.Pages.Minigame
@using ClickerGame.Client.Models
@inject IJSRuntime JS

<div class="wiring-game-screen" tabindex="0" @ref="gameContainerRef" @onkeydown="HandleKeyDown">
    <!-- Top Bar -->
    <header class="game-hud-bar">
        <div class="hud-left">
            <span class="hud-tag font-mono">KESKUSASENNUS // NOPEA KYTKENTÄ</span>
            <h2 class="hud-title font-heading">
                @(CurrentGig != null ? $"{CurrentGig.ClientName} // KESKUKSEN KYTKENTÄ" : "KESKUKSEN KYTKENTÄ JA KOESTUS")
            </h2>
        </div>

        <div class="hud-center">
            <div class="hud-pill font-mono">
                <span class="label">STAMINA:</span>
                <span class="val text-cyan">@Math.Round(PlayerStamina, 0)%</span>
            </div>
            <div class="hud-pill font-mono">
                <span class="label">JOHDOT:</span>
                <span class="val text-amber">@connectedWires.Count / @connectionRules.Count</span>
            </div>
            <div class="hud-pill font-mono">
                <span class="label">STATUS:</span>
                <span class="val @(isTested && testSuccess ? "text-green" : isTested ? "text-danger" : "text-cyan")">
                    @(isTested && testSuccess ? "✔ HYVÄKSYTTY" : isTested ? "⚠ VIKA PIIRISSÄ" : "ODOTTAA TESTAUSTA")
                </span>
            </div>
        </div>

        <div class="hud-right">
            <button class="btn-industrial btn-sm btn-tutorial-trigger" @onclick="OpenTutorial">❓ OPAS</button>
            <button class="btn-industrial btn-sm btn-abort" @onclick="AbortGame">✕ KESKEYTÄ</button>
        </div>
    </header>

    <!-- Keyboard Hotkey Shortcut Banner (Näppäinohjaus) -->
    <div class="quick-hotkey-strip font-mono">
        <span class="hotkey-tip-title">⚡ NÄPPÄINOIKOTIET:</span>
        <span class="hotkey-pill" @onclick="QuickConnectNext" title="Paina VÄLILYÖNTIÄ tai ENTERIÄ kytkeäksesi seuraava johto"><kbd>SPACE</kbd> / <kbd>ENTER</kbd> = Kytke seuraava johto</span>
        <span class="hotkey-pill" @onclick="AutoWireAll" title="Paina A kytkeäksesi kaikki kerralla"><kbd>A</kbd> = Kytke kaikki heti</span>
        <span class="hotkey-pill" @onclick="RunPowerTest" title="Paina T koestaaksesi keskuksen"><kbd>T</kbd> = Koesta keskus</span>
        <span class="hotkey-pill" @onclick="ClearAllWires" title="Paina C tyhjentääksesi"><kbd>C</kbd> = Tyhjennä johdot</span>
    </div>

    <!-- Paused Tutorial Modal Overlay (Yksinkertainen rento opas) -->
    @if (showTutorial)
    {
        <div class="tutorial-modal-backdrop">
            <div class="tutorial-modal-card industrial-card">
                <!-- Modal Top Navigation Tabs -->
                <div class="tutorial-header">
                    <div class="tutorial-badge font-mono">PIKAOPAS // @(tutorialStep + 1) / 3</div>
                    <h3 class="tutorial-title font-heading">@GetTutorialStepTitle(tutorialStep)</h3>
                    <button class="btn-close-tut" @onclick="CloseTutorial" title="Sulje tutoriaali">✕</button>
                </div>

                <div class="tutorial-step-tabs font-mono">
                    <button class="step-tab @(tutorialStep == 0 ? "tab-active" : "")" @onclick="() => tutorialStep = 0">
                        1. HELPPO PELAAMINEN
                    </button>
                    <button class="step-tab @(tutorialStep == 1 ? "tab-active" : "")" @onclick="() => tutorialStep = 1">
                        2. NÄPPÄIMET & KLIKKAUS
                    </button>
                    <button class="step-tab @(tutorialStep == 2 ? "tab-active" : "")" @onclick="() => tutorialStep = 2">
                        3. KOESTUS JA PALKKA
                    </button>
                </div>

                <!-- Modal Content Pages -->
                <div class="tutorial-content-body font-mono">
                    @if (tutorialStep == 0)
                    {
                        <!-- STEP 1: Relaxed goal -->
                        <div class="tut-slide">
                            <div class="tut-fun-banner">
                                <span class="fun-emoji">🎮</span>
                                <div class="fun-text">
                                    <strong>Rentoudu ja klikkaile! Ei tarvitse olla insinööri.</strong>
                                    <span>Tavoitteena on vain napsutella sähkökaapin johdot paikoilleen ja kuitata keikasta mukavat rahat ja kokemuspisteet!</span>
                                </div>
                            </div>

                            <div class="tut-instruction-split">
                                <div class="tut-box tut-box-visual">
                                    <h4 class="box-title text-cyan">TAPA 1: NÄPPÄIMISTÖLLÄ (NOPEIN!)</h4>
                                    <p class="box-tip">
                                        Paina vain <kbd class="kbd-lg">SPACE</kbd> (välilyöntiä) tai <kbd class="kbd-lg">ENTER</kbd>! Jokainen painallus napsauttaa seuraavan johdon heti kiinni.
                                    </p>
                                    <div class="easy-badge">⚡ 12 painallusta ja homma valmis!</div>
                                </div>

                                <div class="tut-box tut-box-button">
                                    <h4 class="box-title text-green">TAPA 2: NÄYTTÖÄ KLIKKAAMALLA</h4>
                                    <p class="box-tip">
                                        Paina vasemmalta listasta vihreää <strong>[⚡ KYTKE]</strong> -nappia tai suoraan <strong>[⚡ KYTKE KAIKKI]</strong>, jos haluat valmista yhdellä klikkauksella!
                                    </p>
                                    <div class="easy-badge">👆 Klikkaa suoraan ruudulta!</div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (tutorialStep == 1)
                    {
                        <!-- STEP 2: Connecting details without engineer jargon -->
                        <div class="tut-slide">
                            <p class="tut-intro-text">
                                Jos haluat fiilistellä sähköasentajaa ja klikata ruuveja itse kaapista:
                            </p>

                            <div class="visual-step-diagram" style="padding: 1rem;">
                                <div class="diagram-step">
                                    <span class="step-circle step-circle-start">1</span>
                                    <span class="step-desc">Klikkaa sinisenä vilkkuvaa ruuvia<br/><strong>[1. ALKU]</strong></span>
                                </div>
                                <span class="diagram-arrow">➔</span>
                                <div class="diagram-step">
                                    <span class="step-circle step-circle-end">2</span>
                                    <span class="step-desc">Klikkaa keltaisena vilkkuvaa ruuvia<br/><strong>[2. KOHDE]</strong></span>
                                </div>
                            </div>

                            <div class="tut-note-box">
                                <span class="note-label">✨ VINKKI:</span>
                                <span>Peli näyttää aina selkeän animoidun nuoliviivan ja valon ruuvien välillä. Et voi eksyä! Peli myös valitsee automaattisesti oikean johdinvärin.</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- STEP 3: Testing & Payout -->
                        <div class="tut-slide">
                            <p class="tut-intro-text">
                                Kun kaikki 12 johtoa on kiinni:
                            </p>

                            <div class="tut-test-flow">
                                <div class="test-step-card">
                                    <span class="step-num">1</span>
                                    <strong>PAINA [T] TAI NAPPIA</strong>
                                    <p>Paina näppäimistöltä <kbd>T</kbd> tai klikkaa sinistä <strong>"⚡ KOESTA KESKUS"</strong> -nappia.</p>
                                </div>
                                <div class="test-step-card">
                                    <span class="step-num">2</span>
                                    <strong>VIRTA KYTKETTY</strong>
                                    <p>Kytkin kääntyy, kontaktori vetää kiinni ja moottori pyörähtää käyntiin!</p>
                                </div>
                                <div class="test-step-card">
                                    <span class="step-num">3</span>
                                    <strong>RAHAT TASKUUN</strong>
                                    <p>Saat täyden urakkapalkan tilillesi sekä kokemuspisteitä hahmon kehittämiseen.</p>
                                </div>
                            </div>

                            <div class="ready-cta-box" style="margin-top: 1rem;">
                                <span class="ready-title">VALMIINA KYTKEMÄÄN?</span>
                                <span class="ready-sub">Voit painaa <kbd>SPACE</kbd> ja pelata heti!</span>
                            </div>
                        </div>
                    }
                </div>

                <!-- Modal Bottom Action Bar -->
                <div class="tutorial-footer">
                    <div class="tut-foot-left">
                        @if (tutorialStep > 0)
                        {
                            <button class="btn-industrial btn-sm" @onclick="PrevTutorialStep">
                                ◀ EDELLINEN
                            </button>
                        }
                    </div>

                    <div class="tut-foot-dots">
                        @for (int s = 0; s < 3; s++)
                        {
                            var stepIdx = s;
                            <span class="tut-dot @(tutorialStep == stepIdx ? "dot-active" : "")" 
                                  @onclick="() => tutorialStep = stepIdx"></span>
                        }
                    </div>

                    <div class="tut-foot-right">
                        @if (tutorialStep < 2)
                        {
                            <button class="btn-industrial btn-industrial-cyan btn-sm" @onclick="NextTutorialStep">
                                SEURAAVA SIVU ▶
                            </button>
                        }
                        else
                        {
                            <button class="btn-industrial btn-industrial-cyan btn-lg font-bold" @onclick="CloseTutorial">
                                🎮 ALOITA PELI (SPACE)!
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Main Workspace -->
    <main class="cabinet-workspace">
        <!-- Left: Work Order & Wiring Checklist (Työmääräin / Kytkentälista) -->
        <aside class="schematic-panel industrial-card">
            <div class="panel-header">
                <span class="led-indicator led-cyan"></span>
                <span class="font-heading title">KYTKENTÄOHJE #WD-401</span>
            </div>

            <div class="schematic-body font-mono">
                <div class="schematic-banner">
                    <span class="banner-badge">💡 OHJE:</span>
                    <span>Yhdistä sähkökeskuksen ruuvit toisiinsa. Voit klikata suoraan alta <strong>[⚡ KYTKE]</strong> -nappia tai klikata ruudulla vilkkuvia ruuveja!</span>
                </div>

                <div class="auto-wire-bar">
                    <button class="btn-industrial btn-sm btn-autowire-all" @onclick="AutoWireAll">
                        ⚡ KYTKE KAIKKI AUTOMAATTISESTI
                    </button>
                    @if (connectedWires.Count > 0)
                    {
                        <button class="btn-industrial btn-sm" @onclick="ClearAllWires">
                            🗑 TYHJENNÄ
                        </button>
                    }
                </div>

                <div class="task-checklist">
                    <div class="checklist-header">
                        <span class="checklist-title">KYTKETTÄVÄT JOHTIMET (@connectedWires.Count/@connectionRules.Count):</span>
                    </div>

                    @for (int i = 0; i < connectionRules.Count; i++)
                    {
                        var rule = connectionRules[i];
                        var idx = i;
                        var isDone = IsConnectionMade(rule.FromId, rule.ToId);
                        var isActive = activeRuleIndex == idx;

                        <div class="checklist-item @(isDone ? "item-done" : "") @(isActive ? "item-active" : "")"
                             @onclick="() => SelectActiveRule(idx)">
                            <div class="item-left">
                                <span class="check-box">@(isDone ? "✔" : $"{idx + 1}.")</span>
                                <span class="wire-color-pip" style="background-color: @rule.ColorHex" title="@rule.ColorName"></span>
                                <div class="rule-labels">
                                    <span class="rule-main">@rule.Description</span>
                                    <span class="rule-detail">@rule.FromLabel ➔ @rule.ToLabel</span>
                                </div>
                            </div>

                            <div class="item-right">
                                @if (isDone)
                                {
                                    <button class="btn-item-action btn-item-remove" @onclick:stopPropagation="true" @onclick="() => RemoveConnection(rule.FromId, rule.ToId)">
                                        ✕ IRROTA
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-item-action btn-item-connect" @onclick:stopPropagation="true" @onclick="() => AutoConnectRule(rule)">
                                        ⚡ KYTKE
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Wire Color Palette Tool -->
            <div class="palette-box">
                <span class="palette-title font-mono">KÄYTETTÄVÄ JOHDINVÄRI:</span>
                <div class="color-buttons">
                    @foreach (var c in availableColors)
                    {
                        <button class="color-btn @(selectedColor == c.Hex ? "color-active" : "")" 
                                style="background-color: @c.Hex"
                                title="@c.Name"
                                @onclick="() => selectedColor = c.Hex">
                            <span class="color-badge">@c.Code</span>
                        </button>
                    }
                </div>
                <span class="current-color-label font-mono">@GetColorName(selectedColor)</span>
            </div>
        </aside>

        <!-- Center: Electrical Cabinet Enclosure (Sähkökeskus) -->
        <div class="cabinet-enclosure industrial-card">
            <!-- Instructions & Active Guide Header -->
            <div class="guide-action-bar font-mono">
                @if (ActiveRule != null && !IsConnectionMade(ActiveRule.FromId, ActiveRule.ToId))
                {
                    <div class="active-guide-box">
                        <span class="guide-pulsing-badge">SEURAAVA KYTKENTÄ:</span>
                        <span class="guide-step-text">
                            Kytke <strong style="color: @ActiveRule.ColorHex">@ActiveRule.ColorName</strong>: 
                            <span class="guide-term from-term">1. @ActiveRule.FromLabel</span> ➔ 
                            <span class="guide-term to-term">2. @ActiveRule.ToLabel</span>
                        </span>
                        <span class="guide-tip">(Klikkaa ruudulla vilkkuvaa ruuvia 1 ja sen jälkeen ruuvia 2)</span>
                    </div>
                }
                else
                {
                    <div class="active-guide-box all-connected">
                        <span class="text-green font-bold">✔ KAIKKI 12 JOHDINTA KYTKETTY!</span>
                        <span class="guide-tip">Paina alla olevaa <strong>"⚡ KOESTA KESKUS"</strong> -painiketta testataksesi toiminnan.</span>
                    </div>
                }
            </div>

            <!-- Interactive Cabinet Canvas (Fixed 960x380 workspace for precision overlay) -->
            <div class="cabinet-canvas-container" @ref="canvasContainer">
                <!-- SVG Wire Layer -->
                <svg class="wires-svg-layer" viewBox="0 0 960 380">
                    <defs>
                        <filter id="wire-shadow" x="-10%" y="-10%" width="120%" height="120%">
                            <feDropShadow dx="1" dy="3" stdDeviation="2" flood-color="#000000" flood-opacity="0.7" />
                        </filter>

                        <!-- Animated dash flow for active guide line -->
                        <linearGradient id="guide-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="#00d4ff" />
                            <stop offset="100%" stop-color="#f59e0b" />
                        </linearGradient>
                    </defs>

                    <!-- Active Step Animated Guide Line -->
                    @if (ActiveRule != null && !IsConnectionMade(ActiveRule.FromId, ActiveRule.ToId))
                    {
                        var p1 = GetTerminalPos(ActiveRule.FromId);
                        var p2 = GetTerminalPos(ActiveRule.ToId);
                        <path d="@GetWirePath(p1, p2)" 
                              stroke="url(#guide-grad)" 
                              stroke-width="3" 
                              stroke-dasharray="8 6"
                              fill="none" 
                              class="active-guide-path" />

                        <!-- Beacon rings on active screws -->
                        <circle cx="@p1.X" cy="@p1.Y" r="16" fill="none" stroke="#00d4ff" stroke-width="2" class="beacon-circle" />
                        <circle cx="@p2.X" cy="@p2.Y" r="16" fill="none" stroke="#f59e0b" stroke-width="2" class="beacon-circle delay-beacon" />
                    }

                    <!-- Connected Wires -->
                    @foreach (var wire in connectedWires)
                    {
                        var p1 = GetTerminalPos(wire.FromId);
                        var p2 = GetTerminalPos(wire.ToId);
                        var path = GetWirePath(p1, p2);
                        <path d="@path" 
                              stroke="@wire.Color" 
                              stroke-width="6" 
                              fill="none" 
                              stroke-linecap="round"
                              class="cabinet-wire"
                              filter="url(#wire-shadow)"
                              title="Klikkaa irrottaaksesi tämä johdin"
                              @onclick="() => RemoveWire(wire)" />
                    }

                    <!-- Preview wire when first screw clicked -->
                    @if (selectedTerminalId != null && hoverTerminalId != null && selectedTerminalId != hoverTerminalId)
                    {
                        var p1 = GetTerminalPos(selectedTerminalId);
                        var p2 = GetTerminalPos(hoverTerminalId);
                        <path d="@GetWirePath(p1, p2)" 
                              stroke="@selectedColor" 
                              stroke-width="5" 
                              stroke-dasharray="6 4"
                              fill="none" 
                              class="preview-wire" />
                    }
                </svg>

                <!-- DIN Rail Components Fixed Precision Layout -->
                <div class="components-workspace">
                    <!-- Component 1: Syöttörima X1 -->
                    <div class="din-component comp-x1">
                        <div class="component-header font-mono">
                            <span class="comp-tag">X1: PÄÄSYÖTTÖ</span>
                            <span class="comp-desc">Verkkokaapeli 400V</span>
                        </div>
                        <div class="terminal-group top-group">
                            <div class="terminal-unit @GetTerminalClass("X1_L1")" @onclick='() => ClickTerminal("X1_L1")' @onmouseenter='() => HoverTerminal("X1_L1")'>
                                @if (IsScrewActiveTarget("X1_L1", out var label1)) { <span class="screw-badge badge-@label1.Type">@label1.Text</span> }
                                <span class="term-screw"></span>
                                <span class="term-label">L1</span>
                                <span class="term-sub">Vaihe 1</span>
                            </div>
                            <div class="terminal-unit @GetTerminalClass("X1_L2")" @onclick='() => ClickTerminal("X1_L2")' @onmouseenter='() => HoverTerminal("X1_L2")'>
                                @if (IsScrewActiveTarget("X1_L2", out var label2)) { <span class="screw-badge badge-@label2.Type">@label2.Text</span> }
                                <span class="term-screw"></span>
                                <span class="term-label">L2</span>
                                <span class="term-sub">Vaihe 2</span>
                            </div>
                            <div class="terminal-unit @GetTerminalClass("X1_L3")" @onclick='() => ClickTerminal("X1_L3")' @onmouseenter='() => HoverTerminal("X1_L3")'>
                                @if (IsScrewActiveTarget("X1_L3", out var label3)) { <span class="screw-badge badge-@label3.Type">@label3.Text</span> }
                                <span class="term-screw"></span>
                                <span class="term-label">L3</span>
                                <span class="term-sub">Vaihe 3</span>
                            </div>
                            <div class="terminal-unit @GetTerminalClass("X1_N")" @onclick='() => ClickTerminal("X1_N")' @onmouseenter='() => HoverTerminal("X1_N")'>
                                @if (IsScrewActiveTarget("X1_N", out var label4)) { <span class="screw-badge badge-@label4.Type">@label4.Text</span> }
                                <span class="term-screw"></span>
                                <span class="term-label">N</span>
                                <span class="term-sub">Nolla</span>
                            </div>
                            <div class="terminal-unit term-pe @GetTerminalClass("X1_PE")" @onclick='() => ClickTerminal("X1_PE")' @onmouseenter='() => HoverTerminal("X1_PE")'>
                                @if (IsScrewActiveTarget("X1_PE", out var label5)) { <span class="screw-badge badge-@label5.Type">@label5.Text</span> }
                                <span class="term-screw"></span>
                                <span class="term-label">PE</span>
                                <span class="term-sub">Maa</span>
                            </div>
                        </div>
                    </div>

                    <!-- Component 2: Moottorinsuojakytkin Q1 -->
                    <div class="din-component comp-q1">
                        <div class="component-header font-mono">
                            <span class="comp-tag">Q1: MOOTTORINSUOJA</span>
                            <span class="comp-desc">Oikosulku- & lämpösuoja</span>
                        </div>

                        <!-- Top row: Inputs 1, 3, 5 -->
                        <div class="terminal-group top-group">
                            <div class="terminal-unit @GetTerminalClass("Q1_1")" @onclick='() => ClickTerminal("Q1_1")' @onmouseenter='() => HoverTerminal("Q1_1")'>
                                @if (IsScrewActiveTarget("Q1_1", out var labelq1)) { <span class="screw-badge badge-@labelq1.Type">@labelq1.Text</span> }
                                <span class="term-screw"></span>
                                <span class="term-label">1/L1</span>
                                <span class="term-sub">Tulo 1</span>
                            </div>
                            <div class="terminal-unit @GetTerminalClass("Q1_3")" @onclick='() => ClickTerminal("Q1_3")' @onmouseenter='() => HoverTerminal("Q1_3")'>
                                @if (IsScrewActiveTarget("Q1_3", out var labelq3)) { <span class="screw-badge badge-@labelq3.Type">@labelq3.Text</span> }
                                <span class="term-screw"></span>
                                <span class="term-label">3/L2</span>
                                <span class="term-sub">Tulo 2</span>
                            </div>
                            <div class="terminal-unit @GetTerminalClass("Q1_5")" @onclick='() => ClickTerminal("Q1_5")' @onmouseenter='() => HoverTerminal("Q1_5")'>
                                @if (IsScrewActiveTarget("Q1_5", out var labelq5)) { <span class="screw-badge badge-@labelq5.Type">@labelq5.Text</span> }
                                <span class="term-screw"></span>
                                <span class="term-label">5/L3</span>
                                <span class="term-sub">Tulo 3</span>
                            </div>
                        </div>

                        <div class="component-body">
                            <div class="breaker-switch @(isTested && testSuccess ? "switch-on" : "")">
                                <span class="switch-knob"></span>
                                <span class="switch-status font-mono">@(isTested && testSuccess ? "I (ON)" : "0 (OFF)")</span>
                            </div>
                        </div>

                        <!-- Bottom row: Outputs 2, 4, 6 -->
                        <div class="terminal-group bottom-group">
                            <div class="terminal-unit @GetTerminalClass("Q1_2")" @onclick='() => ClickTerminal("Q1_2")' @onmouseenter='() => HoverTerminal("Q1_2")'>
                                <span class="term-sub">Lähtö 1</span>
                                <span class="term-label">2/T1</span>
                                <span class="term-screw"></span>
                                @if (IsScrewActiveTarget("Q1_2", out var labelq2)) { <span class="screw-badge badge-bottom badge-@labelq2.Type">@labelq2.Text</span> }
                            </div>
                            <div class="terminal-unit @GetTerminalClass("Q1_4")" @onclick='() => ClickTerminal("Q1_4")' @onmouseenter='() => HoverTerminal("Q1_4")'>
                                <span class="term-sub">Lähtö 2</span>
                                <span class="term-label">4/T2</span>
                                <span class="term-screw"></span>
                                @if (IsScrewActiveTarget("Q1_4", out var labelq4)) { <span class="screw-badge badge-bottom badge-@labelq4.Type">@labelq4.Text</span> }
                            </div>
                            <div class="terminal-unit @GetTerminalClass("Q1_6")" @onclick='() => ClickTerminal("Q1_6")' @onmouseenter='() => HoverTerminal("Q1_6")'>
                                <span class="term-sub">Lähtö 3</span>
                                <span class="term-label">6/T3</span>
                                <span class="term-screw"></span>
                                @if (IsScrewActiveTarget("Q1_6", out var labelq6)) { <span class="screw-badge badge-bottom badge-@labelq6.Type">@labelq6.Text</span> }
                            </div>
                        </div>
                    </div>

                    <!-- Component 3: Kontaktori K1 -->
                    <div class="din-component comp-k1">
                        <div class="component-header font-mono">
                            <span class="comp-tag">K1: KONTAKTORI</span>
                            <span class="comp-desc">Sähköisesti ohjattu pääkytkin</span>
                        </div>

                        <!-- Top row: 1, 3, 5, A1 -->
                        <div class="terminal-group top-group">
                            <div class="terminal-unit @GetTerminalClass("K1_1")" @onclick='() => ClickTerminal("K1_1")' @onmouseenter='() => HoverTerminal("K1_1")'>
                                @if (IsScrewActiveTarget("K1_1", out var labelk1)) { <span class="screw-badge badge-@labelk1.Type">@labelk1.Text</span> }
                                <span class="term-screw"></span>
                                <span class="term-label">1</span>
                                <span class="term-sub">Tulo 1</span>
                            </div>
                            <div class="terminal-unit @GetTerminalClass("K1_3")" @onclick='() => ClickTerminal("K1_3")' @onmouseenter='() => HoverTerminal("K1_3")'>
                                @if (IsScrewActiveTarget("K1_3", out var labelk3)) { <span class="screw-badge badge-@labelk3.Type">@labelk3.Text</span> }
                                <span class="term-screw"></span>
                                <span class="term-label">3</span>
                                <span class="term-sub">Tulo 2</span>
                            </div>
                            <div class="terminal-unit @GetTerminalClass("K1_5")" @onclick='() => ClickTerminal("K1_5")' @onmouseenter='() => HoverTerminal("K1_5")'>
                                @if (IsScrewActiveTarget("K1_5", out var labelk5)) { <span class="screw-badge badge-@labelk5.Type">@labelk5.Text</span> }
                                <span class="term-screw"></span>
                                <span class="term-label">5</span>
                                <span class="term-sub">Tulo 3</span>
                            </div>
                            <div class="terminal-unit term-coil @GetTerminalClass("K1_A1")" @onclick='() => ClickTerminal("K1_A1")' @onmouseenter='() => HoverTerminal("K1_A1")'>
                                @if (IsScrewActiveTarget("K1_A1", out var labelka1)) { <span class="screw-badge badge-@labelka1.Type">@labelka1.Text</span> }
                                <span class="term-screw"></span>
                                <span class="term-label">A1</span>
                                <span class="term-sub">Kela +</span>
                            </div>
                        </div>

                        <div class="component-body">
                            <div class="contactor-indicator @(isTested && testSuccess ? "contactor-engaged" : "")">
                                <span class="armature-slot"></span>
                                <span class="font-mono label">@(isTested && testSuccess ? "VEDETTY (ON)" : "AUKI (OFF)")</span>
                            </div>
                        </div>

                        <!-- Bottom row: 2, 4, 6, A2 -->
                        <div class="terminal-group bottom-group">
                            <div class="terminal-unit @GetTerminalClass("K1_2")" @onclick='() => ClickTerminal("K1_2")' @onmouseenter='() => HoverTerminal("K1_2")'>
                                <span class="term-sub">Lähtö 1</span>
                                <span class="term-label">2</span>
                                <span class="term-screw"></span>
                                @if (IsScrewActiveTarget("K1_2", out var labelk2)) { <span class="screw-badge badge-bottom badge-@labelk2.Type">@labelk2.Text</span> }
                            </div>
                            <div class="terminal-unit @GetTerminalClass("K1_4")" @onclick='() => ClickTerminal("K1_4")' @onmouseenter='() => HoverTerminal("K1_4")'>
                                <span class="term-sub">Lähtö 2</span>
                                <span class="term-label">4</span>
                                <span class="term-screw"></span>
                                @if (IsScrewActiveTarget("K1_4", out var labelk4)) { <span class="screw-badge badge-bottom badge-@labelk4.Type">@labelk4.Text</span> }
                            </div>
                            <div class="terminal-unit @GetTerminalClass("K1_6")" @onclick='() => ClickTerminal("K1_6")' @onmouseenter='() => HoverTerminal("K1_6")'>
                                <span class="term-sub">Lähtö 3</span>
                                <span class="term-label">6</span>
                                <span class="term-screw"></span>
                                @if (IsScrewActiveTarget("K1_6", out var labelk6)) { <span class="screw-badge badge-bottom badge-@labelk6.Type">@labelk6.Text</span> }
                            </div>
                            <div class="terminal-unit term-coil @GetTerminalClass("K1_A2")" @onclick='() => ClickTerminal("K1_A2")' @onmouseenter='() => HoverTerminal("K1_A2")'>
                                <span class="term-sub">Kela -</span>
                                <span class="term-label">A2</span>
                                <span class="term-screw"></span>
                                @if (IsScrewActiveTarget("K1_A2", out var labelka2)) { <span class="screw-badge badge-bottom badge-@labelka2.Type">@labelka2.Text</span> }
                            </div>
                        </div>
                    </div>

                    <!-- Component 4: Lähtörima X2 (Moottorille) -->
                    <div class="din-component comp-x2">
                        <div class="component-header font-mono">
                            <span class="comp-tag">X2: MOOTTORILÄHTÖ</span>
                            <span class="comp-desc">Kaapeli kentälle</span>
                        </div>
                        <div class="terminal-group bottom-group">
                            <div class="terminal-unit @GetTerminalClass("X2_U1")" @onclick='() => ClickTerminal("X2_U1")' @onmouseenter='() => HoverTerminal("X2_U1")'>
                                <span class="term-sub">Käämi U1</span>
                                <span class="term-label">U1</span>
                                <span class="term-screw"></span>
                                @if (IsScrewActiveTarget("X2_U1", out var labelxu)) { <span class="screw-badge badge-bottom badge-@labelxu.Type">@labelxu.Text</span> }
                            </div>
                            <div class="terminal-unit @GetTerminalClass("X2_V1")" @onclick='() => ClickTerminal("X2_V1")' @onmouseenter='() => HoverTerminal("X2_V1")'>
                                <span class="term-sub">Käämi V1</span>
                                <span class="term-label">V1</span>
                                <span class="term-screw"></span>
                                @if (IsScrewActiveTarget("X2_V1", out var labelxv)) { <span class="screw-badge badge-bottom badge-@labelxv.Type">@labelxv.Text</span> }
                            </div>
                            <div class="terminal-unit @GetTerminalClass("X2_W1")" @onclick='() => ClickTerminal("X2_W1")' @onmouseenter='() => HoverTerminal("X2_W1")'>
                                <span class="term-sub">Käämi W1</span>
                                <span class="term-label">W1</span>
                                <span class="term-screw"></span>
                                @if (IsScrewActiveTarget("X2_W1", out var labelxw)) { <span class="screw-badge badge-bottom badge-@labelxw.Type">@labelxw.Text</span> }
                            </div>
                            <div class="terminal-unit term-pe @GetTerminalClass("X2_PE")" @onclick='() => ClickTerminal("X2_PE")' @onmouseenter='() => HoverTerminal("X2_PE")'>
                                <span class="term-sub">Maa</span>
                                <span class="term-label">PE</span>
                                <span class="term-screw"></span>
                                @if (IsScrewActiveTarget("X2_PE", out var labelxpe)) { <span class="screw-badge badge-bottom badge-@labelxpe.Type">@labelxpe.Text</span> }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom Test Console -->
            <div class="cabinet-test-bar">
                <div class="test-status-msg font-mono">
                    @if (!string.IsNullOrEmpty(testFeedback))
                    {
                        <span class="@(testSuccess ? "text-green font-bold" : "text-danger font-bold")">@testFeedback</span>
                    }
                    else if (connectedWires.Count == connectionRules.Count)
                    {
                        <span class="text-green font-bold">✔ Kaikki johtimet asennettu! Paina "KOESTA KESKUS" suorittaaksesi käyttöönottotarkastuksen.</span>
                    }
                    else
                    {
                        <span class="text-muted">Kytke kaikki 12 johdinta ja paina "KOESTA KESKUS".</span>
                    }
                </div>

                <div class="test-controls">
                    <button class="btn-industrial btn-industrial-cyan btn-lg btn-test-power" @onclick="RunPowerTest">
                        ⚡ KOESTA KESKUS [TEST POWER]
                    </button>
                </div>
            </div>
        </div>
    </main>

    <!-- Loppupöytäkirja / Tarkastusraportti Modal -->
    @if (isGameOver && finalResult != null)
    {
        <div class="result-modal-backdrop">
            <div class="industrial-card result-report-card">
                <div class="report-header">
                    <div class="stamp-badge stamp-@finalResult.Grade.ToLower()">@finalResult.Grade.ToUpper()</div>
                    <h3 class="report-title font-heading">KESKUKSEN KÄYTTÖÖNOTTOPÖYTÄKIRJA</h3>
                    <span class="report-sub font-mono">SFS 6000 KÄYTTÖÖNOTTOTARKASTUS HYVÄKSYTTY</span>
                </div>

                <div class="report-body font-mono">
                    <div class="report-stat-row">
                        <span>KYTKENNÄN TARKKUUS:</span>
                        <span class="text-cyan font-bold">@Math.Round(finalResult.Precision, 1)%</span>
                    </div>
                    <div class="report-stat-row">
                        <span>URAKKAPALKKIO:</span>
                        <span class="text-green font-bold">+@finalResult.PayEur.ToString("0") €</span>
                    </div>
                    <div class="report-stat-row">
                        <span>KOKEMUSPISTEET:</span>
                        <span class="text-amber font-bold">+@finalResult.XpGained XP</span>
                    </div>
                    <div class="report-stat-row">
                        <span>MAINEVAIKUTUS:</span>
                        <span class="font-bold @(finalResult.RepDelta >= 0 ? "text-green" : "text-danger")">
                            @(finalResult.RepDelta >= 0 ? $"+{finalResult.RepDelta}" : finalResult.RepDelta.ToString()) MAINETTA
                        </span>
                    </div>
                </div>

                <div class="report-actions">
                    <button class="btn-industrial btn-industrial-cyan btn-lg" @onclick="SubmitResult">
                        ✔ HYVÄKSY JA PALAA KALENTERIIN
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
.wiring-game-screen {
    position: fixed;
    inset: 0;
    background-color: #080b11;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    user-select: none;
}

.cabinet-workspace {
    flex: 1;
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 1.25rem;
    padding: 1.25rem;
    overflow: hidden;
}

/* Schematic Panel */
.schematic-panel {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    overflow-y: auto;
}

.schematic-banner {
    background: rgba(0, 212, 255, 0.08);
    border: 1px solid rgba(0, 212, 255, 0.3);
    border-radius: 4px;
    padding: 0.6rem;
    font-size: 0.7rem;
    color: #e2e8f0;
    line-height: 1.4;
}

.banner-badge {
    color: var(--cyan-primary);
    font-weight: 800;
    display: block;
    margin-bottom: 2px;
}

.auto-wire-bar {
    display: flex;
    gap: 0.5rem;
}

.btn-autowire-all {
    flex: 1;
    background: #0284c7;
    color: #ffffff;
    font-weight: 700;
}

.btn-autowire-all:hover {
    background: #0369a1;
}

.task-checklist {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: #090d15;
    border: 1px solid var(--border-color);
    padding: 0.6rem;
    border-radius: 4px;
    max-height: 380px;
    overflow-y: auto;
}

.checklist-title {
    color: var(--amber-primary);
    font-weight: 700;
    font-size: 0.7rem;
}

.checklist-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.35rem 0.45rem;
