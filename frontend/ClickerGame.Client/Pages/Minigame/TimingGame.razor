@namespace ClickerGame.Client.Pages.Minigame
@using ClickerGame.Client.Models
@using System.Threading
@implements IDisposable
@inject IJSRuntime JS

<div class="timing-game-screen @(isFlashHit ? "flash-hit" : "") @(isFlashMiss ? "flash-miss" : "")" 
     tabindex="0" 
     @ref="gameContainerRef"
     @onkeydown="HandleKeyDown">

    <!-- Top Instrument Bar -->
    <header class="game-hud-bar">
        <div class="hud-left">
            <span class="hud-tag font-mono">MITTALAITE // CALIBRATION RIG MK-IV</span>
            <h2 class="hud-title font-heading">
                @(CurrentGig != null ? $"{CurrentGig.ClientName} // VAIHETAHDISTUS" : "GENERAATTORIN VAIHEKALIBROINTI")
            </h2>
        </div>

        <div class="hud-center">
            <div class="hud-pill font-mono">
                <span class="label">STAMINA:</span>
                <span class="val text-cyan">@Math.Round(PlayerStamina, 0)%</span>
            </div>
            <div class="hud-pill font-mono">
                <span class="label">SYKLI:</span>
                <span class="val">@(completedCycles + 1) / @maxCycles</span>
            </div>
            <div class="hud-pill font-mono">
                <span class="label">PUTKI (STREAK):</span>
                <span class="val @(streak >= 3 ? "text-amber" : "")">@streak@(streak >= 3 ? " 🔥" : "")</span>
            </div>
        </div>

        <div class="hud-right">
            <button class="btn-industrial btn-sm btn-abort" @onclick="AbortGame">
                ✕ KESKEYTÄ
            </button>
        </div>
    </header>

    <!-- Phase Banner & 24-LED Step Progress Bar -->
    <div class="hud-phase-strip">
        <div class="phase-info font-heading">
            <span class="phase-badge font-mono">@CurrentPhaseTitle</span>
            <span class="phase-progress-text font-mono">EDISTYMINEN: @completedCycles / @maxCycles SYKLIÄ</span>
        </div>
        <div class="led-strip-container">
            @for (int i = 0; i < maxCycles; i++)
            {
                var idx = i;
                var isCurrent = idx == completedCycles;
                var isPast = idx < attemptResults.Count;
                var isHit = isPast && attemptResults[idx].IsHit;
                var isMiss = isPast && !attemptResults[idx].IsHit;

                <div class="led-pip @(isCurrent ? "led-current" : isHit ? "led-hit" : isMiss ? "led-miss" : "led-future")"
                     title="Sykli @(idx + 1)">
                </div>
            }
        </div>
    </div>

    @if (!isGameOver)
    {
        <!-- Main Oscilloscope / Dial Canvas -->
        <main class="game-stage">
            <div class="scope-housing @(IsInsideSector ? "housing-locked" : "")">
                <div class="bezel-screw top-left"></div>
                <div class="bezel-screw top-right"></div>
                <div class="bezel-screw bottom-left"></div>
                <div class="bezel-screw bottom-right"></div>

                <div class="scope-screen @(IsInsideSector ? "scope-screen-locked" : "")">
                    <!-- Oscilloscope Grid Lines -->
                    <div class="scope-grid"></div>

                    <!-- Ambient radar glow when target in pocket -->
                    <div class="target-ambient-wash @(IsInsideSector ? "wash-active" : "")"></div>

                    <!-- SVG Circular Gauge -->
                    <svg viewBox="0 0 320 320" class="dial-svg">
                        <defs>
                            <!-- Glow filters -->
                            <filter id="cyan-glow" x="-30%" y="-30%" width="160%" height="160%">
                                <feGaussianBlur stdDeviation="5" result="blur" />
                                <feMerge>
                                    <feMergeNode in="blur" />
                                    <feMergeNode in="SourceGraphic" />
                                </feMerge>
                            </filter>
                            <filter id="laser-glow" x="-50%" y="-50%" width="200%" height="200%">
                                <feGaussianBlur stdDeviation="8" result="blur" />
                                <feMerge>
                                    <feMergeNode in="blur" />
                                    <feMergeNode in="SourceGraphic" />
                                </feMerge>
                            </filter>
                        </defs>

                        <!-- Outer Metal Dial Ring -->
                        <circle cx="160" cy="160" r="140" class="dial-outer-ring" />
                        <circle cx="160" cy="160" r="120" class="dial-track-ring" />

                        <!-- Degree ticks every 30 deg (0 deg = 12 o'clock / Top) -->
                        @for (int deg = 0; deg < 360; deg += 30)
                        {
                            var rad = (deg - 90) * Math.PI / 180.0;
                            var x1 = 160 + 132 * Math.Cos(rad);
                            var y1 = 160 + 132 * Math.Sin(rad);
                            var x2 = 160 + 120 * Math.Cos(rad);
                            var y2 = 160 + 120 * Math.Sin(rad);
                            <line x1="@x1.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" 
                                  y1="@y1.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" 
                                  x2="@x2.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" 
                                  y2="@y2.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" 
                                  class="dial-tick" />
                        }

                        <!-- TARGET SECTOR: Shaded Phosphor Wedge Track (r=95, width=50 covers r=70 to 120) -->
                        <circle cx="160" cy="160" r="95"
                                class="dial-sector-wedge @(IsInsideSector ? "wedge-active" : "")"
                                transform="rotate(@((sectorStartAngle - 90.0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)), 160, 160)"
                                style="stroke-dasharray: @((2.0 * Math.PI * 95.0 * (sectorArcDegrees / 360.0)).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)) @((2.0 * Math.PI * 95.0 * (1.0 - (sectorArcDegrees / 360.0))).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)); stroke-dashoffset: 0;" />

                        <!-- Target Sector Outer Arc -->
                        <circle cx="160" cy="160" r="120" 
                                class="dial-sector-arc @(IsInsideSector ? "arc-active" : "")"
                                transform="rotate(@((sectorStartAngle - 90.0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)), 160, 160)"
                                style="stroke-dasharray: @sectorArcLength.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) @((circumference - sectorArcLength).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)); stroke-dashoffset: 0;" />

                        <!-- Target Sector Inner Arc -->
                        <circle cx="160" cy="160" r="70" 
                                class="dial-sector-inner @(IsInsideSector ? "arc-active" : "")"
                                transform="rotate(@((sectorStartAngle - 90.0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)), 160, 160)"
                                style="stroke-dasharray: @((2.0 * Math.PI * 70.0 * (sectorArcDegrees / 360.0)).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)) @((2.0 * Math.PI * 70.0 * (1.0 - (sectorArcDegrees / 360.0))).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)); stroke-dashoffset: 0;" />

                        <!-- Sector Gate Line: ENTRY (Laser Boundary) -->
                        <g transform="rotate(@((sectorStartAngle - 90.0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)), 160, 160)">
                            <line x1="230" y1="160" x2="280" y2="160" class="sector-gate-line gate-entry" />
                            <circle cx="280" cy="160" r="4" class="gate-pip" />
                        </g>

                        <!-- Sector Gate Line: EXIT (Laser Boundary) -->
                        <g transform="rotate(@(((sectorStartAngle + sectorArcDegrees - 90.0) % 360.0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)), 160, 160)">
                            <line x1="230" y1="160" x2="280" y2="160" class="sector-gate-line gate-exit" />
                            <circle cx="280" cy="160" r="4" class="gate-pip" />
                        </g>

                        <!-- Center Target Pip (Sweet Spot) on Sector Arc -->
                        <g transform="rotate(@(((sectorStartAngle + (sectorArcDegrees / 2.0) - 90.0) % 360.0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)), 160, 160)">
                            <polygon points="280,156 285,160 280,164 275,160" class="sweet-spot-diamond" />
                        </g>

                        <!-- Central Target Lock Reticle (Instinctive visual indicator) -->
                        <g class="dial-reticle @(IsInsideSector ? "reticle-locked" : "")">
                            <circle cx="160" cy="160" r="28" class="reticle-ring" />
                            <circle cx="160" cy="160" r="38" class="reticle-pulse-ring" />
                            <line x1="160" y1="126" x2="160" y2="136" class="reticle-crosshair" />
                            <line x1="160" y1="184" x2="160" y2="194" class="reticle-crosshair" />
                            <line x1="126" y1="160" x2="136" y2="160" class="reticle-crosshair" />
                            <line x1="184" y1="160" x2="194" y2="160" class="reticle-crosshair" />
                        </g>

                        <!-- Rotating Needle / Light Signal (0 deg = 12 o'clock / Top) -->
                        <g transform="rotate(@currentAngle.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture), 160, 160)">
                            <!-- Laser Needle Line -->
                            <line x1="160" y1="160" x2="160" y2="35" class="dial-needle @(IsInsideSector ? "needle-laser-active" : "")" />
                            <!-- Rotating Signal Head / Blip -->
                            <circle cx="160" cy="35" r="@(IsInsideSector ? "13" : "8")" class="dial-signal-dot @(IsInsideSector ? "dot-laser-active" : "")" />
                        </g>

                        <!-- Center Pivot -->
                        <circle cx="160" cy="160" r="16" class="dial-center-cap" />
                        <circle cx="160" cy="160" r="6" class="dial-center-pin @(IsInsideSector ? "pin-active" : "")" />
                    </svg>

                    <!-- Real-time HUD stats on dial -->
                    <div class="dial-readouts font-mono">
                        <div class="readout-item">
                            <span class="readout-label">KULMA:</span>
                            <span class="readout-val">@Math.Round(currentAngle, 0)°</span>
                        </div>
                        <div class="readout-item">
                            <span class="readout-label">LUKITUS:</span>
                            <span class="readout-val @(IsInsideSector ? "text-cyan font-bold" : "text-muted")">
                                @(IsInsideSector ? "⚡ LUKITTAVISSA!" : "○ ODOTTAA...")
                            </span>
                        </div>
                        <div class="readout-item">
                            <span class="readout-label">LEVEYS:</span>
                            <span class="readout-val">@Math.Round(sectorArcDegrees, 0)°</span>
                        </div>
                    </div>
                </div>

                <!-- Big Tactical Trigger Button below screen -->
                <div class="scope-console">
                    <button class="btn-industrial btn-hit @(IsInsideSector ? "btn-hit-active" : "btn-hit-idle")" @onclick="TriggerHit">
                        <span class="hit-icon">⚡</span>
                        <span class="hit-label font-heading">
                            @(IsInsideSector ? "LUKITSE NYT! [ VÄLILYÖNTI ]" : "VALMISTAUDU... [ VÄLILYÖNTI ]")
                        </span>
                    </button>
                </div>
            </div>

            <!-- Side Instrument Telemetry -->
            <div class="telemetry-panel industrial-card">
                <div class="telemetry-header">
                    <span class="led-indicator led-cyan"></span>
                    <span class="font-heading title">ANTURILOGI</span>
                </div>

                <div class="telemetry-body font-mono">
                    <div class="metric-row">
                        <span>VAIHE:</span>
                        <span class="text-cyan">@CurrentPhase / 3</span>
                    </div>
                    <div class="metric-row">
                        <span>STAMINA:</span>
                        <span>@Math.Round(PlayerStamina, 0)%</span>
                    </div>
                    <div class="metric-row">
                        <span>IKKUNA:</span>
                        <span>@Math.Round((0.5 + 0.5 * (PlayerStamina / 100)) * 100, 0)%</span>
                    </div>

                    <hr class="telemetry-divider" />

                    <div class="history-log">
                        <span class="log-title">SYKLITULOKSET (@attemptResults.Count / @maxCycles):</span>
                        @if (attemptResults.Count == 0)
                        {
                            <span class="log-empty">Paina välilyöntiä kun valo osuu siniselle sektorille...</span>
                        }
                        else
                        {
                            @for (int i = attemptResults.Count - 1; i >= 0; i--)
                            {
                                var res = attemptResults[i];
                                <div class="log-entry @(res.IsHit ? "log-hit" : "log-miss")">
                                    <span>#@(i + 1) @(res.IsHit ? "OSUMA" : "HUDI")</span>
                                    <span>@(res.IsHit ? $"{res.Accuracy:0}%" : "0%") @(res.StreakBonus ? "🔥" : "")</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </main>
    }
    else
    {
        <!-- Result Report Modal -->
        <div class="result-modal-backdrop">
            <div class="industrial-card result-report-card">
                <div class="report-header">
                    <div class="stamp-badge @GetGradeStampClass()">@finalResult!.Grade.ToUpper()</div>
                    <h3 class="report-title font-heading">HUOLTOTEHTÄVÄN TARKASTUSPÖYTÄKIRJA</h3>
                    <span class="report-sub font-mono">24 SYKLIN KALIBROINTISARJA VALMIS</span>
                </div>

                <div class="report-body font-mono">
                    <div class="report-stat-row">
                        <span>KOKONAISTARKKUUS:</span>
                        <span class="text-cyan font-bold">@Math.Round(finalResult.Precision, 1)%</span>
                    </div>
                    <div class="report-stat-row">
                        <span>HYVÄKSYTYT SYKLIT:</span>
                        <span>@attemptResults.Count(r => r.IsHit) / @maxCycles</span>
                    </div>
                    <div class="report-stat-row">
                        <span>URAKKAPALKKIO:</span>
                        <span class="text-green font-bold">+@finalResult.PayEur.ToString("0") €</span>
                    </div>
                    <div class="report-stat-row">
                        <span>KOKEMUSPISTEET:</span>
                        <span class="text-amber font-bold">+@finalResult.XpGained XP</span>
                    </div>
                    <div class="report-stat-row">
                        <span>MAINEVAIKUTUS:</span>
                        <span class="font-bold @(finalResult.RepDelta >= 0 ? "text-green" : "text-danger")">
                            @(finalResult.RepDelta >= 0 ? $"+{finalResult.RepDelta}" : finalResult.RepDelta.ToString()) MAINETTA
                        </span>
                    </div>
                </div>

                <div class="report-actions">
                    <button class="btn-industrial btn-industrial-cyan btn-lg" @onclick="SubmitResult">
                        ✔ HYVÄKSY JA PALAA KALENTERIIN
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
.timing-game-screen {
    position: fixed;
    inset: 0;
    background-color: #080b11;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    outline: none;
    user-select: none;
    transition: background-color 0.15s ease;
}

/* Flash feedback */
.flash-hit {
    box-shadow: inset 0 0 70px rgba(0, 212, 255, 0.5);
    animation: flash-cyan 0.25s ease-out;
}

.flash-miss {
    box-shadow: inset 0 0 70px rgba(239, 68, 68, 0.6);
    animation: flash-red 0.3s ease-out;
}

@@keyframes flash-cyan {
    0% { background-color: #0e2436; }
    100% { background-color: #080b11; }
}

@@keyframes flash-red {
    0% { background-color: #330f0f; }
    100% { background-color: #080b11; }
}

/* Top HUD */
.game-hud-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: #111622;
    border-bottom: 2px solid var(--border-color);
}

.hud-tag {
    font-size: 0.65rem;
    color: var(--amber-primary);
}

.hud-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
    color: #ffffff;
}

.hud-center {
    display: flex;
    gap: 1rem;
}

.hud-pill {
    background: #090c13;
    border: 1px solid var(--border-color);
    padding: 0.25rem 0.65rem;
    border-radius: 3px;
    font-size: 0.8rem;
    display: flex;
    gap: 0.4rem;
}

.hud-pill .label { color: var(--text-muted); }
.hud-pill .val { font-weight: 700; }
.hud-pill .text-cyan { color: var(--cyan-primary); }
.hud-pill .text-amber { color: var(--amber-primary); }

.btn-abort {
    border-color: #ef4444;
    color: #fca5a5;
    font-size: 0.75rem;
}

/* Phase Strip & LED Progress Bar */
.hud-phase-strip {
    background: #0b0f19;
    border-bottom: 1px solid #1c2638;
    padding: 0.45rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
}

.phase-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
}

.phase-badge {
    color: var(--amber-primary);
    font-weight: 700;
    letter-spacing: 0.06em;
}

.phase-progress-text {
    color: var(--cyan-primary);
    font-size: 0.7rem;
}

.led-strip-container {
    display: grid;
    grid-template-columns: repeat(24, 1fr);
    gap: 4px;
    height: 10px;
    background: #060910;
    padding: 2px 4px;
    border-radius: 3px;
    border: 1px solid #1e293b;
}

.led-pip {
    border-radius: 2px;
    transition: all 0.2s ease;
}

.led-future {
    background: #1e293b;
}

.led-current {
    background: var(--cyan-primary);
    box-shadow: 0 0 8px var(--cyan-primary);
    animation: pulse-led 0.6s infinite alternate;
}

.led-hit {
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
}

.led-miss {
    background: #ef4444;
    box-shadow: 0 0 6px #ef4444;
}

@@keyframes pulse-led {
    from { opacity: 0.4; }
    to { opacity: 1; }
}

/* Main Stage */
.game-stage {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 1rem 1.5rem;
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
}

/* Oscilloscope Housing */
.scope-housing {
    background: #141a27;
    border: 3px solid #2a354c;
    border-radius: 12px;
    padding: 1.25rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7), inset 0 2px 0 rgba(255, 255, 255, 0.1);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    transition: all 0.15s ease;
}

.housing-locked {
    border-color: #00d4ff;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7), 0 0 30px rgba(0, 212, 255, 0.25);
}

.bezel-screw {
    position: absolute;
    width: 10px;
    height: 10px;
    background: #394765;
    border-radius: 50%;
    border: 1px solid #1c2436;
}

.bezel-screw::after {
    content: '';
    position: absolute;
    top: 4px;
    left: 1px;
    width: 8px;
    height: 2px;
    background: #1c2436;
}

.top-left { top: 8px; left: 8px; }
.top-right { top: 8px; right: 8px; }
.bottom-left { bottom: 8px; left: 8px; }
.bottom-right { bottom: 8px; right: 8px; }

/* CRT Screen */
.scope-screen {
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, #0e202a 0%, #061016 100%);
    border: 2px solid #00d4ff44;
    border-radius: 50%;
    position: relative;
    overflow: hidden;
    box-shadow: inset 0 0 30px rgba(0, 212, 255, 0.15), 0 0 20px rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
}

.scope-screen-locked {
    border-color: #00f0ff !important;
    box-shadow: inset 0 0 50px rgba(0, 229, 255, 0.4), 0 0 40px rgba(0, 229, 255, 0.45) !important;
}

/* Grid overlay */
.scope-grid {
    position: absolute;
    inset: 0;
    background-image: 
        radial-gradient(circle, rgba(0, 212, 255, 0.08) 1px, transparent 1px),
        linear-gradient(to right, rgba(0, 212, 255, 0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 212, 255, 0.04) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
}

.target-ambient-wash {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(0, 212, 255, 0.25) 0%, transparent 70%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.1s ease;
}

.wash-active {
    opacity: 1;
}

/* SVG Dial */
.dial-svg {
    width: 100%;
    height: 100%;
    position: relative;
    z-index: 2;
}

.dial-outer-ring {
    fill: none;
    stroke: #25334a;
    stroke-width: 4;
}

.dial-track-ring {
    fill: none;
    stroke: rgba(0, 212, 255, 0.15);
    stroke-width: 8;
}

.dial-tick {
    stroke: #48618a;
    stroke-width: 2;
}

/* Target Sector Elements */
.dial-sector-wedge {
    fill: none;
    stroke: rgba(0, 212, 255, 0.18);
    stroke-width: 50;
    transition: all 0.1s ease;
}

.wedge-active {
    stroke: rgba(0, 240, 255, 0.48) !important;
    filter: drop-shadow(0 0 16px rgba(0, 240, 255, 0.8));
}

.dial-sector-arc {
    fill: none;
    stroke: var(--cyan-primary);
    stroke-width: 10;
    stroke-linecap: round;
    filter: drop-shadow(0 0 8px var(--cyan-glow));
    transition: all 0.1s ease;
}

.dial-sector-inner {
    fill: none;
    stroke: rgba(0, 212, 255, 0.6);
    stroke-width: 3;
    stroke-linecap: round;
}

.arc-active {
    stroke: #ffffff !important;
    stroke-width: 13 !important;
    filter: drop-shadow(0 0 14px #00f0ff) !important;
}

/* Gate boundaries */
.sector-gate-line {
    stroke-width: 3;
    stroke-linecap: round;
}

.gate-entry {
    stroke: #34d399;
    filter: drop-shadow(0 0 6px #34d399);
}

.gate-exit {
    stroke: #f43f5e;
    filter: drop-shadow(0 0 6px #f43f5e);
}

.gate-pip {
    fill: #ffffff;
}

.sweet-spot-diamond {
    fill: #fbbf24;
    filter: drop-shadow(0 0 6px #fbbf24);
}

/* Central Reticle */
.dial-reticle {
    opacity: 0.3;
    transition: all 0.1s ease;
}

.reticle-ring {
    fill: none;
    stroke: var(--cyan-primary);
    stroke-width: 2;
}

.reticle-pulse-ring {
    fill: none;
    stroke: var(--cyan-primary);
    stroke-width: 1;
    stroke-dasharray: 4 4;
}

.reticle-crosshair {
    stroke: var(--cyan-primary);
    stroke-width: 2;
}

.reticle-locked {
    opacity: 1 !important;
}

.reticle-locked .reticle-ring {
    stroke: #10b981 !important;
    stroke-width: 3;
    filter: drop-shadow(0 0 10px #10b981);
}

.reticle-locked .reticle-pulse-ring {
    stroke: #34d399 !important;
    animation: spin-reticle 2s linear infinite;
}

@@keyframes spin-reticle {
    from { transform: rotate(0deg); transform-origin: 160px 160px; }
    to { transform: rotate(360deg); transform-origin: 160px 160px; }
}

/* Needle / Rotating Signal */
.dial-needle {
    stroke: #ffb703;
    stroke-width: 3;
    stroke-linecap: round;
    transition: stroke 0.08s ease;
}

.needle-laser-active {
    stroke: #ffffff !important;
