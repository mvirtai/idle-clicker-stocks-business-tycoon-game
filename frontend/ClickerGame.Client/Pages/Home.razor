    private double CalculateTotalPassiveRate()
    {
        double rate = state.Player.PassiveIncomePerSec;
        foreach (var u in upgrades.Where(x => x.Level > 0))
        {
            rate += u.PassiveIncomeBonus * u.Level;
        }
        return rate;
    }

    // Workstation Click Handlers
    private void HandleAddCash(double cash)
    {
        int newMinute = state.Player.CurrentMinute + 1;
        int newHour = state.Player.CurrentHour;
        if (newMinute >= 60)
        {
            newHour = (newHour + (newMinute / 60)) % 24;
            newMinute %= 60;
        }

        state = state with
        {
            Player = state.Player with
            {
                Cash = state.Player.Cash + cash,
                LifetimeCash = state.Player.LifetimeCash + cash,
                TotalClicks = state.Player.TotalClicks + 1,
                CurrentHour = newHour,
                CurrentMinute = newMinute
            }
        };

        _ = Task.Run(async () =>
        {
            try
            {
                await JS.InvokeVoidAsync("ThemeManager.setTimeOfDay", newHour, newMinute);
            }
            catch { }
        });
    }

    private void HandleAddXp(int xp)
    {
        int newXp = state.Player.Xp + xp;
        int req = state.Player.Level * 200;
        int lvl = state.Player.Level;

        if (newXp >= req)
        {
            lvl++;
            newXp -= req;
            ShowStatus($"TASO NOUSI! Olet nyt tasolla {lvl}! Työvoima kasvoi.", "bg-emerald-950/80 text-emerald-300 border-emerald-500/40");
            try { JS.InvokeVoidAsync("GameAudio.playSuccess"); } catch { }
        }

        state = state with { Player = state.Player with { Xp = newXp, Level = lvl } };
    }

    private void HandleAddRep(int rep)
    {
        int newRep = Math.Clamp(state.Player.PersonalRep + rep, 0, 200);
        state = state with { Player = state.Player with { PersonalRep = newRep } };
    }

    private void HandleConsumeStamina(float st)
    {
        float drainRed = 0f;
        foreach (var u in upgrades.Where(x => x.Level > 0))
        {
            drainRed += u.StaminaDrainReduction;
        }
        drainRed = Math.Clamp(drainRed, 0f, 0.7f);

        float effectiveDrain = st * (1.0f - drainRed);
        float newSt = Math.Clamp(state.Player.Stamina - effectiveDrain, 0f, 100f);
        state = state with { Player = state.Player with { Stamina = newSt } };
    }

    // Upgrades Purchase Handler
    private void HandlePurchaseUpgrade(UpgradeItem item)
    {
        if (state.Player.Cash >= item.CurrentCost && !item.IsMaxLevel)
        {
            double cost = item.CurrentCost;
            int idx = upgrades.FindIndex(u => u.Id == item.Id);
            if (idx != -1)
            {
                var updated = item with { Level = item.Level + 1, Unlocked = true };
                upgrades[idx] = updated;

                // If certs, add to player certs
                if (item.Id == "certs-2" && !state.Player.Certifications.Contains("plc_basics"))
                {
                    state.Player.Certifications.Add("plc_basics");
                }

                // If loan package, pay down 2000 € directly
                if (item.Id == "comp-3")
                {
                    currentLoan = currentLoan with { Principal = Math.Max(0, currentLoan.Principal - 2000.0) };
                }

                state = state with
                {
                    Player = state.Player with
                    {
                        Cash = state.Player.Cash - cost,
                        PersonalRep = Math.Clamp(state.Player.PersonalRep + item.RepBonus, 0, 200)
                    }
                };

                ShowStatus($"Parannus '{item.Name}' asennettu! (Taso {updated.Level}/{updated.MaxLevel})", "bg-emerald-950/80 text-emerald-300 border-emerald-500/40");
            }
        }
    }

    // Loan Repayment
    private void HandleRepayLoan(double amount)
    {
        if (state.Player.Cash >= amount && currentLoan.Principal > 0)
        {
            double paid = Math.Min(amount, currentLoan.Principal);
            currentLoan = currentLoan with { Principal = currentLoan.Principal - paid };
            state = state with
            {
                Player = state.Player with
                {
                    Cash = state.Player.Cash - paid
                }
            };
            ShowStatus($"Pankkilainaa lyhennetty {paid:N0} €! Kodin panttiriski laski {currentLoan.CollateralRiskPercent:F1} %:iin.", "bg-emerald-950/80 text-emerald-300 border-emerald-500/40");
        }
    }

    // Calendar & Gig selection handlers
    private void HandleSelectGigFromMarket(Gig gig)
    {
        if (selectedGigToAssign?.Id == gig.Id)
        {
            selectedGigToAssign = null;
        }
        else
        {
            selectedGigToAssign = gig;
            ShowStatus($"Valittu: {gig.ClientName} ({gig.DurationDays} pv). Klikkaa kalenterin vapaata päivää.", "bg-amber-950/80 text-amber-300 border-amber-500/40");
        }
    }

    private void HandleDaySelected(string dayKey)
    {
        if (selectedGigToAssign != null)
        {
            HandleAssignGig((dayKey, selectedGigToAssign));
        }
    }

    private void HandleAssignGig((string DayKey, Gig Gig) payload)
    {
        var (startDay, gig) = payload;
        int startIndex = Array.IndexOf(DaysSequence, startDay);
        if (startIndex == -1) return;

        for (int i = 0; i < gig.DurationDays; i++)
        {
            int targetIdx = startIndex + i;
            if (targetIdx >= DaysSequence.Length)
            {
                ShowStatus("Keikka ei mahdu viikon loppuun!", "bg-rose-950/80 text-rose-300 border-rose-500/40");
                return;
            }
        }

        for (int i = 0; i < gig.DurationDays; i++)
        {
            string day = DaysSequence[startIndex + i];
            weekPlan.Days[day] = new WeekSlot("gig", gig.Id);
        }

        selectedGigToAssign = null;
        ShowStatus($"Keikka '{gig.ClientName}' sijoitettu päiviin alkaen {startDay}!", "bg-emerald-950/80 text-emerald-300 border-emerald-500/40");
    }

    private void HandleClearSlot(string dayKey)
    {
        if (weekPlan.Days.TryGetValue(dayKey, out var slot))
        {
            if (slot.Type == "gig" && !string.IsNullOrEmpty(slot.GigId))
            {
                var gigId = slot.GigId;
                foreach (var k in DaysSequence)
                {
                    if (weekPlan.Days.TryGetValue(k, out var s) && s.GigId == gigId && s.Result == null)
                    {
                        weekPlan.Days[k] = new WeekSlot("empty");
                    }
                }
            }
            else
            {
                weekPlan.Days[dayKey] = new WeekSlot("empty");
            }
            ShowStatus($"Päivä {dayKey} tyhjennetty.", "bg-amber-950/80 text-amber-300 border-amber-500/40");
        }
    }

    private void HandleQuickAction((string DayKey, string ActionType) payload)
    {
        if (payload.ActionType == "rest")
        {
            weekPlan.Days[payload.DayKey] = new WeekSlot("rest");
            ShowStatus($"Päivä {payload.DayKey} merkitty lepopäiväksi.", "bg-emerald-950/80 text-emerald-300 border-emerald-500/40");
        }
    }

    private void ExecuteDay(string dayKey)
    {
        if (!weekPlan.Days.TryGetValue(dayKey, out var slot))
        {
            slot = new WeekSlot("empty");
        }

        if (slot.Type == "gig" && !string.IsNullOrEmpty(slot.GigId))
        {
            var gig = availableGigs.FirstOrDefault(g => g.Id == slot.GigId);
            activeMinigameGig = gig ?? new Gig("sample", "sample", "Teollisuushuolto", 1, 1, 100, 200, new List<string>(), 0, "");
        }
        else if (slot.Type == "rest" || slot.Type == "empty")
        {
            RestToday();
        }
        else
        {
            ShowStatus($"Päivä {dayKey} suoritettu.", "bg-emerald-950/80 text-emerald-300 border-emerald-500/40");
            AdvanceNextDay();
        }
    }

    private void HandleMinigameCompleted(MinigameResult result)
    {
        var currentDay = state.Player.DayOfWeek;
        var gig = activeMinigameGig;
        activeMinigameGig = null;

        weekPlan.Days[currentDay] = new WeekSlot("gig", gig?.Id, null, result);

        float newStamina = Math.Clamp(state.Player.Stamina - 18f, 0f, 100f);
        double newCash = state.Player.Cash + result.PayEur;
        double newLife = state.Player.LifetimeCash + result.PayEur;
        int newRep = Math.Clamp(state.Player.PersonalRep + result.RepDelta, 0, 200);
        int newXp = state.Player.Xp + result.XpGained;
        int newLevel = state.Player.Level;

        int reqXp = state.Player.Level * 200;
        if (newXp >= reqXp)
        {
            newLevel++;
            newXp -= reqXp;
            ShowStatus($"ONNITTELUT! Nousit tasolle {newLevel}!", "bg-emerald-950/80 text-emerald-300 border-emerald-500/40");
        }
        else
        {
            ShowStatus($"Päivä suoritettu: {result.Grade.ToUpper()}! +{result.PayEur:0} € | +{result.XpGained} XP", "bg-emerald-950/80 text-emerald-300 border-emerald-500/40");
        }

        state = state with
        {
            Player = state.Player with
            {
                Stamina = newStamina,
                Cash = newCash,
                LifetimeCash = newLife,
                PersonalRep = newRep,
                Xp = newXp,
                Level = newLevel
            }
        };

        AdvanceNextDay();
    }

    private void CancelMinigame()
    {
        activeMinigameGig = null;
        ShowStatus("Minipeli peruutettu.", "bg-amber-950/80 text-amber-300 border-amber-500/40");
    }

    private void RestToday()
    {
        float newStamina = Math.Clamp(state.Player.Stamina + 40f, 0f, 100f);
        weekPlan.Days[state.Player.DayOfWeek] = new WeekSlot("rest", null, null, null);

        state = state with
        {
            Player = state.Player with
            {
                Stamina = newStamina
            }
        };

        ShowStatus($"Lepopäivä suoritettu! Stamina palautui (+40) -> {Math.Round(newStamina, 0)}%.", "bg-emerald-950/80 text-emerald-300 border-emerald-500/40");
        AdvanceNextDay();
    }

    private void AdvanceNextDay()
    {
        int currentIndex = Array.IndexOf(DaysSequence, state.Player.DayOfWeek);
        if (currentIndex == -1) currentIndex = 0;

        if (currentIndex == DaysSequence.Length - 1)
        {
            // End of week summary (Sunday -> Next Week Monday)
            // Deduct living expenses: 150 €, plus weekly debt service if active
            double deductions = 150.0;
            if (currentLoan.Principal > 0)
            {
                deductions += currentLoan.WeeklyPayment;
                currentLoan = currentLoan with { Principal = Math.Max(0, currentLoan.Principal - (currentLoan.WeeklyPayment * 0.7)) };
            }

            double afterExpenses = state.Player.Cash - deductions;
            int nextWeek = state.Player.Week + 1;

            state = state with
            {
                Player = state.Player with
                {
                    Week = nextWeek,
                    DayOfWeek = "MA",
                    Cash = afterExpenses,
                    CurrentHour = 8,
                    CurrentMinute = 0
                }
            };

            _ = Task.Run(async () =>
            {
                try { await JS.InvokeVoidAsync("ThemeManager.setTimeOfDay", 8, 0); } catch { }
            });

            foreach (var d in DaysSequence)
            {
                weekPlan.Days[d] = new WeekSlot("empty");
            }

            ShowStatus($"Viikko {nextWeek} alkoi! Kulut ja lainanlyhennys (-{deductions:N0} €) veloitettu kassasta.", "bg-amber-950/80 text-amber-300 border-amber-500/40");
        }
        else
        {
            string nextDay = DaysSequence[currentIndex + 1];
            state = state with
            {
                Player = state.Player with
                {
                    DayOfWeek = nextDay,
                    CurrentHour = 8,
                    CurrentMinute = 0
                }
            };

            _ = Task.Run(async () =>
            {
                try { await JS.InvokeVoidAsync("ThemeManager.setTimeOfDay", 8, 0); } catch { }
            });
        }
    }

