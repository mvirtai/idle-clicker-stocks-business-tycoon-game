    [Parameter] public Gig? CurrentGig { get; set; }
    [Parameter] public float PlayerStamina { get; set; } = 100f;
    [Parameter] public EventCallback<MinigameResult> OnComplete { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private ElementReference canvasContainer;
    private ElementReference gameContainerRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await gameContainerRef.FocusAsync();
            }
            catch { }
        }
    }

    // Tutorial state (active on launch)
    private bool showTutorial = true;
    private int tutorialStep = 0;

    private void OpenTutorial()
    {
        showTutorial = true;
        tutorialStep = 0;
    }

    private void CloseTutorial()
    {
        showTutorial = false;
        try { _ = gameContainerRef.FocusAsync(); } catch { }
    }

    private void NextTutorialStep()
    {
        if (tutorialStep < 2) tutorialStep++;
    }

    private void PrevTutorialStep()
    {
        if (tutorialStep > 0) tutorialStep--;
    }

    private string GetTutorialStepTitle(int step) => step switch
    {
        0 => "1. HELPPO JA RENTO PELITAPA",
        1 => "2. NÄPPÄIMET & KLIKKAILU",
        _ => "3. KOESTUS & PALKKA"
    };

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (showTutorial)
        {
            if (e.Key is " " or "Enter")
            {
                if (tutorialStep < 2) tutorialStep++;
                else CloseTutorial();
            }
            else if (e.Key is "Escape")
            {
                CloseTutorial();
            }
            return;
        }

        if (isGameOver)
        {
            if (e.Key is " " or "Enter")
            {
                _ = SubmitResult();
            }
            return;
        }

        var key = e.Key.ToLowerInvariant();
        if (key is " " or "enter")
        {
            // Connect next wire or run test if all connected
            if (connectedWires.Count >= connectionRules.Count)
            {
                _ = RunPowerTest();
            }
            else
            {
                QuickConnectNext();
            }
        }
        else if (key is "a")
        {
            AutoWireAll();
        }
        else if (key is "t")
        {
            _ = RunPowerTest();
        }
        else if (key is "c")
        {
            ClearAllWires();
        }
        else if (key is "escape")
        {
            _ = AbortGame();
        }
    }

    private void QuickConnectNext()
    {
        if (connectedWires.Count >= connectionRules.Count)
        {
            return;
        }

        var nextRule = ActiveRule ?? connectionRules.FirstOrDefault(r => !IsConnectionMade(r.FromId, r.ToId));
        if (nextRule != null)
        {
            AutoConnectRule(nextRule);
        }
    }

