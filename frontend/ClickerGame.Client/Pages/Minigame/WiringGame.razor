    border-color: #3b82f6;
}

.checklist-item.item-active {
    border-color: var(--cyan-primary);
    background: #112240;
    box-shadow: 0 0 8px rgba(0, 212, 255, 0.3);
}

.checklist-item.item-done {
    background: rgba(34, 197, 94, 0.08);
