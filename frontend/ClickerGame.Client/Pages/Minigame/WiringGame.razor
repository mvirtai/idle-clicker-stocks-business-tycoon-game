    private void SelectActiveRule(int index)
    {
        activeRuleIndex = index;
        if (ActiveRule != null)
        {
            selectedColor = ActiveRule.ColorHex;
        }
    }

    private void ClickTerminal(string termId)
    {
        if (selectedTerminalId == null)
        {
            selectedTerminalId = termId;
            try { JS.InvokeVoidAsync("GameAudio.playTick"); } catch { }
        }
        else if (selectedTerminalId == termId)
        {
            selectedTerminalId = null; // deselect
            try { JS.InvokeVoidAsync("GameAudio.playTick"); } catch { }
        }
        else
        {
            // Connect selected screw and clicked screw
            AddWire(selectedTerminalId, termId, selectedColor);
            selectedTerminalId = null;

            // Advance active rule to next unfinished rule
            AdvanceToNextUnfinishedRule();
        }
    }

    private void HoverTerminal(string termId) => hoverTerminalId = termId;

    private void AddWire(string from, string to, string color)
    {
        // Don't add duplicate wire
        if (IsConnectionMade(from, to)) return;

        connectedWires.Add(new WireConnection(from, to, color));
        try { JS.InvokeVoidAsync("GameAudio.playTick"); } catch { }
    }

    private void AutoConnectRule(WiringRule rule)
    {
        AddWire(rule.FromId, rule.ToId, rule.ColorHex);
        AdvanceToNextUnfinishedRule();
    }

    private void AutoWireAll()
    {
        connectedWires.Clear();
        foreach (var rule in connectionRules)
        {
            connectedWires.Add(new WireConnection(rule.FromId, rule.ToId, rule.ColorHex));
        }
        try { JS.InvokeVoidAsync("GameAudio.playSuccess"); } catch { }
        activeRuleIndex = -1;
    }

    private void RemoveConnection(string fromId, string toId)
    {
        connectedWires.RemoveAll(w => (w.FromId == fromId && w.ToId == toId) || (w.FromId == toId && w.ToId == fromId));
        try { JS.InvokeVoidAsync("GameAudio.playMiss"); } catch { }
    }

    private void RemoveWire(WireConnection wire)
    {
        connectedWires.Remove(wire);
        try { JS.InvokeVoidAsync("GameAudio.playMiss"); } catch { }
    }

    private void ClearAllWires()
    {
        connectedWires.Clear();
        activeRuleIndex = 0;
    }

    private void AdvanceToNextUnfinishedRule()
    {
        for (int i = 0; i < connectionRules.Count; i++)
        {
            if (!IsConnectionMade(connectionRules[i].FromId, connectionRules[i].ToId))
            {
                activeRuleIndex = i;
                selectedColor = connectionRules[i].ColorHex;
                return;
            }
        }
        activeRuleIndex = -1;
    }

    private bool IsConnectionMade(string fromId, string toId) =>
        connectedWires.Any(w => (w.FromId == fromId && w.ToId == toId) || (w.FromId == toId && w.ToId == fromId));

    private bool IsScrewActiveTarget(string termId, out (string Text, string Type) label)
    {
        if (selectedTerminalId == termId)
        {
            label = ("✔ VALITTU", "selected");
            return true;
        }

        if (ActiveRule != null && !IsConnectionMade(ActiveRule.FromId, ActiveRule.ToId))
        {
            if (ActiveRule.FromId == termId)
            {
                label = ("1. ALKU", "start");
                return true;
            }
            if (ActiveRule.ToId == termId)
            {
                label = ("2. KOHDE", "end");
                return true;
            }
        }

        label = ("", "");
        return false;
    }

    private string GetTerminalClass(string termId)
    {
        if (selectedTerminalId == termId) return "term-selected";

        if (ActiveRule != null && !IsConnectionMade(ActiveRule.FromId, ActiveRule.ToId))
        {
            if (ActiveRule.FromId == termId) return "term-active-start";
            if (ActiveRule.ToId == termId) return "term-active-end";
        }

        return "";
    }

    private string GetColorName(string hex) =>
        availableColors.FirstOrDefault(c => c.Hex == hex)?.Name ?? hex;

    private (int X, int Y) GetTerminalPos(string termId) =>
        terminalCoords.TryGetValue(termId, out var pos) ? pos : (100, 100);

    private string GetWirePath((int X, int Y) p1, (int X, int Y) p2)
    {
        int dx = p2.X - p1.X;
        int dy = p2.Y - p1.Y;
        
        // Arc curves downwards for bottom terminals and upwards for top terminals
        int ctrlY;
        if (p1.Y >= 180 && p2.Y >= 180)
        {
            ctrlY = Math.Max(p1.Y, p2.Y) + 60 + Math.Abs(dx) / 10;
        }
        else if (p1.Y <= 120 && p2.Y <= 120)
        {
            ctrlY = Math.Min(p1.Y, p2.Y) - 50 - Math.Abs(dx) / 10;
        }
        else
        {
            ctrlY = (p1.Y + p2.Y) / 2 + 40;
        }

        return $"M {p1.X} {p1.Y} Q {(p1.X + p2.X)/2} {ctrlY} {p2.X} {p2.Y}";
    }

    private async Task RunPowerTest()
    {
        isTested = true;
        int correctMatches = 0;
        int missingCount = 0;
        int wrongWires = 0;

        foreach (var rule in connectionRules)
        {
            if (IsConnectionMade(rule.FromId, rule.ToId))
            {
                correctMatches++;
            }
            else
            {
                missingCount++;
            }
        }

        foreach (var wire in connectedWires)
        {
            if (!connectionRules.Any(r => (r.FromId == wire.FromId && r.ToId == wire.ToId) || (r.FromId == wire.ToId && r.ToId == wire.FromId)))
            {
                wrongWires++;
            }
        }

        float precision = Math.Clamp((float)correctMatches / connectionRules.Count * 100f - (wrongWires * 15f), 0f, 100f);

        if (precision >= 90f)
        {
            testSuccess = true;
            testFeedback = "✔ KAIKKI VAIHEET JA OHJAUS KYTKETTY OIKEIN! Moottori käynnistyy moitteetta.";
            try { await JS.InvokeVoidAsync("GameAudio.playSuccess"); } catch { }
        }
        else
        {
            testSuccess = false;
            testFeedback = missingCount > 0 
                ? $"⚠ KOESTUS HYLÄTTY: {missingCount} johdinta puuttuu tai väärässä navassa!" 
                : $"⚠ KOESTUS HYLÄTTY: Piirissä on {wrongWires} virheellistä kytkentää!";
            try { await JS.InvokeVoidAsync("GameAudio.playMiss"); } catch { }
        }

        _ = Task.Delay(1300).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                FinishGame(precision);
            });
        });
    }

    private void FinishGame(float precision)
    {
        isGameOver = true;
        string grade = precision >= 90f ? "perfect" : precision >= 60f ? "good" : "fail";
        double basePay = CurrentGig != null ? (CurrentGig.PayMin + CurrentGig.PayMax) / 2.0 : 250.0;
        double payout = grade switch
        {
            "perfect" => basePay * 1.25,
            "good" => basePay,
            _ => basePay * 0.4
        };

        int xp = grade switch
        {
            "perfect" => 130,
            "good" => 75,
            _ => 20
        };

        int repDelta = grade switch
        {
            "perfect" => 6,
            "good" => 1,
            _ => -8
        };

        finalResult = new MinigameResult(precision, grade, xp, repDelta, payout);
        StateHasChanged();
    }

    private Task SubmitResult() => finalResult != null ? OnComplete.InvokeAsync(finalResult) : Task.CompletedTask;
    private Task AbortGame() => OnCancel.InvokeAsync();
}
