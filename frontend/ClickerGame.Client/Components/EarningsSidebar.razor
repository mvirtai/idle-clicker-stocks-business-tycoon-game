@namespace ClickerGame.Client.Components
@using ClickerGame.Client.Models
@inject IJSRuntime JS

<aside class="luminous-panel luminous-panel-amber p-4 md:p-5 flex flex-col h-full gap-4 text-slate-100 relative overflow-hidden shadow-2xl">
    <!-- Ambient Golden/Amber Light Glow -->
    <div class="absolute -top-24 -right-24 w-60 h-60 bg-amber-500/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-60 h-60 bg-rose-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Header: Golden Currency Beacon -->
    <div class="border-b border-amber-500/30 pb-3 z-10 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
            <span class="text-2xl filter drop-shadow-[0_0_10px_#f59e0b]">💰</span>
            <div>
                <div class="text-[10px] font-mono text-amber-400 font-black uppercase tracking-widest flex items-center gap-1.5">
                    <span>KASSAVIRTA & PÄÄOMA</span>
                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                </div>
                <div class="text-base font-heading font-black text-white tracking-wide">
                    LASKUTUS & PANKKIVELKA
                </div>
            </div>
        </div>
        <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-gradient-to-r from-amber-500/20 to-orange-500/20 text-amber-300 border border-amber-500/40 shadow-sm">
            VIIKKO @Player.Week
        </span>
    </div>

    <div class="space-y-4 flex-1 overflow-y-auto pr-1 z-10">
        
        <!-- 1. Real-time Glowing Capital & Cashflow Rates -->
        <div class="bg-gradient-to-b from-slate-900/95 to-slate-950/95 rounded-2xl p-3.5 border border-amber-500/30 space-y-3 shadow-xl">
            <div class="text-[11px] font-mono text-slate-300 uppercase tracking-wider flex justify-between items-center">
                <span class="flex items-center gap-1.5 text-amber-300 font-bold">
                    <span class="inline-block w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_6px_#f59e0b]"></span>
                    LIKVIDI KASSA
                </span>
                <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 font-bold border border-emerald-500/30 animate-pulse">
                    +@GetPassiveRatePerSecond().ToString("F2") €/s AUTO
                </span>
            </div>

            <!-- Prominent Glowing Cash Readout -->
            <div class="flex items-baseline justify-between bg-black/70 p-3 rounded-xl border border-amber-500/40 shadow-[inset_0_2px_8px_rgba(0,0,0,0.8),0_0_15px_rgba(245,158,11,0.15)]">
                <span class="text-xs font-mono font-bold text-slate-400">PÄÄOMA:</span>
                <div class="text-2xl font-mono font-black text-amber-300 flex items-center gap-1 filter drop-shadow-[0_0_8px_#f59e0b]">
                    <span class="text-amber-500 text-lg">€</span>
                    <span>@Player.Cash.ToString("N2", new System.Globalization.CultureInfo("fi-FI"))</span>
                </div>
            </div>

            <!-- Invoicing Rates Grid with Vibrant Colors -->
            <div class="grid grid-cols-2 gap-2 text-xs font-mono">
                <div class="bg-slate-900/90 p-2.5 rounded-xl border border-emerald-500/30 shadow-md">
                    <div class="text-[10px] text-emerald-400 font-bold flex items-center gap-1">
                        <span>⚡</span>
                        <span>PASSIIVINEN</span>
                    </div>
                    <div class="text-emerald-300 font-black text-sm mt-0.5 filter drop-shadow-[0_0_6px_#10b981]">
                        +@GetPassiveRatePerSecond().ToString("F2") €/s
                    </div>
                    <div class="text-[10px] text-slate-400 mt-0.5">(@(GetPassiveRatePerSecond() * 60).ToString("F0") € / min)</div>
                </div>

                <div class="bg-slate-900/90 p-2.5 rounded-xl border border-cyan-500/30 shadow-md">
                    <div class="text-[10px] text-cyan-400 font-bold flex items-center gap-1">
                        <span>🔨</span>
                        <span>KÄSITYÖVOIMA</span>
                    </div>
                    <div class="text-cyan-300 font-black text-sm mt-0.5 filter drop-shadow-[0_0_6px_#06b6d4]">
                        @GetClickPower().ToString("F2") € / klik
                    </div>
                    <div class="text-[10px] text-slate-400 mt-0.5">Taso @Player.Level bonus</div>
                </div>
            </div>

            <!-- Living Expenses Burn Rate -->
            <div class="flex justify-between items-center text-xs font-mono pt-1 text-slate-300 border-t border-slate-800">
                <span class="flex items-center gap-1">
                    <span>🛒</span>
                    <span>Elinkustannukset (su):</span>
                </span>
                <span class="text-rose-400 font-black">-150.00 € / vk</span>
            </div>
        </div>

        <!-- 2. The High-Stakes Tycoon Drama: Bank Loan & Family Home Collateral -->
        <div class="bg-gradient-to-b from-slate-950/95 via-rose-950/20 to-slate-950/95 rounded-2xl p-4 border border-rose-500/40 relative overflow-hidden shadow-xl">
            <!-- Glowing red warning beacon -->
            <div class="flex items-center justify-between border-b border-rose-500/30 pb-2 mb-2.5">
                <div class="flex items-center gap-2">
                    <span class="relative flex h-3 w-3">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-500 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-3 w-3 bg-rose-600 shadow-[0_0_10px_#f43f5e]"></span>
                    </span>
                    <span class="text-xs font-mono text-rose-300 font-black uppercase tracking-wider">
                        PANKKILAINA & KODIN KIINNITYS
                    </span>
                </div>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-300 font-black border border-rose-500/40 shadow-[0_0_8px_rgba(244,63,94,0.3)]">
                    RISKI: @Math.Round(CurrentLoan.CollateralRiskPercent, 1)%
                </span>
            </div>

            <!-- House Visual & Stakes Narrative -->
            <div class="flex items-center gap-3 bg-black/60 p-3 rounded-xl border border-rose-500/20 mb-3">
                <div class="text-3xl filter drop-shadow-[0_0_10px_#f43f5e] p-1.5 rounded-lg bg-rose-500/10 border border-rose-500/30">
                    🏡
                </div>
                <div class="text-[11px] text-slate-200 leading-snug">
                    <strong class="text-white">Perheen koti panttina:</strong> 180 000 € arvoinen talo takaa yrityskaupan lainaa. Jokainen lyhennys vapauttaa kotiasi!
                </div>
            </div>

            <!-- Loan Progress Bar vs Home Value -->
            <div class="space-y-1.5 mb-3">
                <div class="flex justify-between text-[11px] font-mono">
                    <span class="text-slate-400">Jäljellä oleva velka:</span>
                    <span class="text-white font-bold">@CurrentLoan.Principal.ToString("N0", new System.Globalization.CultureInfo("fi-FI")) € / 180 000 €</span>
                </div>
                <div class="h-3 w-full bg-black/80 rounded-full overflow-hidden border border-rose-500/30 p-0.5">
                    <div class="h-full bg-gradient-to-r from-emerald-500 via-amber-500 to-rose-600 transition-all duration-300 rounded-full shadow-[0_0_10px_#f43f5e]"
                         style="width: @(CurrentLoan.CollateralRiskPercent)%"></div>
                </div>
            </div>

            <!-- Debt service telemetry -->
            <div class="bg-slate-900/80 p-2.5 rounded-xl border border-slate-800 text-xs font-mono space-y-1 mb-3">
                <div class="flex justify-between text-slate-300">
                    <span>Viikoittainen pankkilyhennys:</span>
                    <span class="text-amber-400 font-bold">-@CurrentLoan.WeeklyPayment.ToString("F0") €</span>
                </div>
                <div class="flex justify-between text-slate-400 text-[11px]">
                    <span>Korko (1.8% p.a.):</span>
                    <span class="text-rose-400">@(Math.Round(CurrentLoan.Principal * 0.00035, 1)) € / pv</span>
                </div>
            </div>

            <!-- Colorful Payment Action Buttons -->
            <div class="grid grid-cols-2 gap-2">
                <button class="py-2 px-3 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-xs font-mono font-black transition-all shadow-md shadow-emerald-500/20 active:scale-95 disabled:opacity-30 disabled:cursor-not-allowed"
                        disabled="@(Player.Cash < 250 || CurrentLoan.Principal <= 0)"
                        @onclick="() => PayLoan(250)">
                    Lyhennä 250 €
                </button>
                <button class="py-2 px-3 rounded-xl bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white text-xs font-mono font-black transition-all shadow-md shadow-cyan-500/20 active:scale-95 disabled:opacity-30 disabled:cursor-not-allowed"
                        disabled="@(Player.Cash < 1000 || CurrentLoan.Principal <= 0)"
                        @onclick="() => PayLoan(1000)">
                    Lyhennä 1 000 €
                </button>
            </div>
            @if (CurrentLoan.Principal <= 0)
            {
                <div class="mt-2.5 p-2 text-center bg-gradient-to-r from-emerald-500/20 via-teal-500/20 to-emerald-500/20 text-emerald-300 rounded-xl border border-emerald-400 text-xs font-mono font-black shadow-[0_0_15px_rgba(16,185,129,0.3)]">
                    🎉 KOTI ON TÄYSIN VAPAA VELASTA!
                </div>
            }
        </div>

        <!-- 3. Client Connections & Colorful Trust Bars -->
        <div class="bg-gradient-to-b from-slate-900/90 to-slate-950/90 rounded-2xl p-3.5 border border-white/10 space-y-2.5 shadow-xl">
            <div class="text-[11px] font-mono text-slate-300 uppercase tracking-wider flex justify-between items-center">
                <span class="text-cyan-400 font-bold flex items-center gap-1.5">
                    <span>🤝</span>
                    <span>ASIAKASSUHTEET & LUOTTAMUS</span>
                </span>
                <span class="text-[10px] font-mono text-cyan-300 px-2 py-0.5 rounded-full bg-cyan-500/20 border border-cyan-500/30 font-bold">
                    @(Player.Connections.Count) ASIAKASTA
                </span>
            </div>

            <div class="space-y-2">
                @foreach (var conn in Player.Connections)
                {
                    <div class="p-2.5 rounded-xl bg-slate-950/80 border border-slate-800 flex items-center justify-between text-xs hover:border-cyan-500/40 transition-colors">
                        <div class="flex items-center gap-2">
                            <span class="text-lg">@GetClientIcon(conn.ClientId)</span>
                            <div>
                                <div class="font-heading font-bold text-white">@FormatClientName(conn.ClientId)</div>
                                <div class="text-[10px] font-mono text-slate-400">
                                    @conn.GigsCompleted keikkaa • Laatu @conn.AvgPrecision.ToString("F0")%
                                </div>
                            </div>
                        </div>
                        <div class="text-right font-mono">
                            <span class="px-2 py-0.5 rounded-full bg-gradient-to-r from-cyan-500/20 to-blue-500/20 text-cyan-300 text-[10px] font-black border border-cyan-500/40">
                                +@(conn.Tier * 10)% LISÄ
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- 4. Career Milestones & Sparkling Trophies -->
        <div class="bg-slate-950/90 rounded-2xl p-3.5 border border-white/10 space-y-2 font-mono text-xs text-slate-300 shadow-xl">
            <div class="text-[10px] uppercase text-amber-400 font-black border-b border-slate-800 pb-1.5 flex items-center gap-1.5">
                <span>🏆</span>
                <span>URAN SAAVUTUKSET & MAINE</span>
            </div>
            <div class="flex justify-between items-center">
                <span class="text-slate-400">Laskutettu yhteensä:</span>
                <span class="text-cyan-300 font-black text-sm filter drop-shadow-[0_0_6px_#06b6d4]">
                    @Player.LifetimeCash.ToString("N0", new System.Globalization.CultureInfo("fi-FI")) €
                </span>
            </div>
            <div class="flex justify-between items-center">
                <span class="text-slate-400">Työsuoritteet:</span>
                <span class="text-amber-300 font-black">@Player.TotalClicks kpl</span>
            </div>
            <div class="flex justify-between items-center">
                <span class="text-slate-400">Maine (Max 200):</span>
                <span class="text-emerald-300 font-black flex items-center gap-1">
                    <span>⭐</span>
                    <span>@Player.PersonalRep / 200</span>
                </span>
            </div>
        </div>

    </div>
</aside>

@code {
    [Parameter, EditorRequired] public PlayerState Player { get; set; } = default!;
    [Parameter] public LoanState CurrentLoan { get; set; } = new LoanState();
    [Parameter] public List<UpgradeItem>? Upgrades { get; set; }
    [Parameter] public EventCallback<double> OnRepayLoan { get; set; }

    private double GetPassiveRatePerSecond()
    {
        double rate = Player.PassiveIncomePerSec;
        if (Upgrades != null)
        {
            foreach (var u in Upgrades.Where(x => x.Level > 0))
            {
                rate += u.PassiveIncomeBonus * u.Level;
            }
        }
        return rate;
    }

    private double GetClickPower()
    {
        double p = Player.BaseClickValue > 0 ? Player.BaseClickValue : 6.0;
        if (Upgrades != null)
        {
            foreach (var u in Upgrades.Where(x => x.Level > 0))
            {
                p += u.ClickBonus * u.Level;
            }
        }
        return p;
    }

    private async Task PayLoan(double amount)
    {
        try { await JS.InvokeVoidAsync("GameAudio.playSuccess"); } catch { }
        await OnRepayLoan.InvokeAsync(amount);
    }

    private string FormatClientName(string id) => id switch
    {
        "peltipaja" => "Peltipaja Oy",
        "paikallisputki" => "Paikallisputki",
        "kiinteisto" => "Kaupungin Kiinteistöhuolto",
        "sementti" => "Sementtitehdas Oy",
        "panimo" => "Panimo Oy",
        _ => id
    };

    private string GetClientIcon(string id) => id switch
    {
        "peltipaja" => "🏭",
        "paikallisputki" => "🚰",
        "kiinteisto" => "🏢",
        "sementti" => "🏗️",
        "panimo" => "🍻",
        _ => "🏢"
    };
}
