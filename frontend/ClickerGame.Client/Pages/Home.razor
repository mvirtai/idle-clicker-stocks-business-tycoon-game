@page "/"
@using ClickerGame.Client.Models
@using ClickerGame.Client.Components
@using ClickerGame.Client.Pages.Minigame
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>From Gigs to Giants</PageTitle>

@if (activeMinigameGig != null)
{
    <!-- Full-screen Minigame Mode based on Gig MinigameType -->
    @if (activeMinigameGig.MinigameType == "wiring")
    {
        <WiringGame CurrentGig="activeMinigameGig"
                    PlayerStamina="state.Player.Stamina"
                    OnComplete="HandleMinigameCompleted"
                    OnCancel="CancelMinigame" />
    }
    else if (activeMinigameGig.MinigameType == "troubleshooting")
    {
        <TroubleshootingGame CurrentGig="activeMinigameGig"
                             PlayerStamina="state.Player.Stamina"
                             OnComplete="HandleMinigameCompleted"
                             OnCancel="CancelMinigame" />
    }
    else
    {
        <TimingGame CurrentGig="activeMinigameGig"
                    PlayerStamina="state.Player.Stamina"
                    OnComplete="HandleMinigameCompleted"
                    OnCancel="CancelMinigame" />
    }
}
else
{
    <div class="min-h-screen @GetContainerThemeClass() flex flex-col font-body selection:bg-cyan-500 selection:text-black transition-colors duration-700">
        
        <!-- 1. Header Stats Bar (Integrated luminous control bezel) -->
        <StatsBar Player="state.Player" Company="state.Company" OnThemeModeChanged="HandleThemeModeChanged" />

        <!-- Notification Banner if any -->
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="px-5 py-2 flex items-center justify-between text-xs font-mono font-bold tracking-wide border-b @statusBannerClass transition-all">
                <div class="flex items-center gap-2">
                    <span>⚡</span>
                    <span>@statusMessage</span>
                </div>
                <button class="text-slate-400 hover:text-white p-1" @onclick="() => statusMessage = null">✕</button>
            </div>
        }

        <!-- Top Navigation / View Switcher (Clean, focused tab navigation) -->
        <div class="px-4 py-2 bg-slate-900/95 border-b border-cyan-500/20 backdrop-blur-md flex flex-wrap items-center justify-between gap-3 text-xs font-mono sticky top-0 z-40 shadow-md">
            <div class="flex items-center gap-1.5 p-1 bg-slate-950/80 rounded-xl border border-white/10">
                <button class="px-3.5 py-1.5 rounded-lg font-bold transition-all flex items-center gap-1.5 @(activeViewTab == "workstation" ? "bg-cyan-500 text-slate-950 shadow-md shadow-cyan-500/30 font-black" : "text-slate-300 hover:text-cyan-300 hover:bg-white/5")"
                        @onclick='() => activeViewTab = "workstation"'>
                    <span>⚡</span>
                    <span>TYÖASEMA</span>
                </button>
                <button class="px-3.5 py-1.5 rounded-lg font-bold transition-all flex items-center gap-1.5 @(activeViewTab == "calendar" ? "bg-amber-500 text-slate-950 shadow-md shadow-amber-500/30 font-black" : "text-slate-300 hover:text-amber-300 hover:bg-white/5")"
                        @onclick='() => activeViewTab = "calendar"'>
                    <span>📅</span>
                    <span>KEIKAT & KALENTERI</span>
                </button>
                <button class="px-3.5 py-1.5 rounded-lg font-bold transition-all flex items-center gap-1.5 @(activeViewTab == "upgrades" ? "bg-emerald-500 text-slate-950 shadow-md shadow-emerald-500/30 font-black" : "text-slate-300 hover:text-emerald-300 hover:bg-white/5")"
                        @onclick='() => activeViewTab = "upgrades"'>
                    <span>🛠️</span>
                    <span>PAJAPÄIVITYKSET</span>
                </button>
                <button class="px-3.5 py-1.5 rounded-lg font-bold transition-all flex items-center gap-1.5 @(activeViewTab == "company" ? "bg-purple-500 text-white shadow-md shadow-purple-500/30 font-black" : "text-slate-300 hover:text-purple-300 hover:bg-white/5")"
                        @onclick='() => activeViewTab = "company"'>
                    <span>🏢</span>
                    <span>YRITYS & PANKKI</span>
                </button>
            </div>

            <!-- Quick Day Advance & Coffee Break -->
            <div class="flex items-center gap-2">
                <span class="text-slate-300 hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-black/40 border border-white/10 text-xs">
                    <span>🗓️</span>
                    <strong class="text-cyan-300">@state.Player.DayOfWeek</strong>
                    <span class="text-slate-500">|</span>
                    <span class="text-amber-300 font-bold">VK @state.Player.Week</span>
                </span>
                <button class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-heading font-black text-xs shadow-sm active:scale-95 flex items-center gap-1.5 transition-all"
                        @onclick="AdvanceNextDay">
                    <span>⏭</span>
                    <span>SEURAAVA PÄIVÄ</span>
                </button>
                <button class="px-2.5 py-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold text-xs flex items-center gap-1 transition-all"
                        title="Nopea kahvitauko (+40 Stamina)"
                        @onclick="RestToday">
                    <span>☕</span>
                    <span class="hidden md:inline">KAHVI</span>
                </button>
                <button class="px-2 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-white border border-slate-700 text-xs"
                        title="Pikatestit"
                        @onclick="ToggleDevToggles">
                    ⚙
                </button>
            </div>
        </div>

        <!-- Dev Controls Drawer -->
        @if (showDevControls)
        {
            <div class="px-4 py-2 bg-slate-900/95 border-b border-amber-500/30 flex flex-wrap items-center gap-2 text-xs font-mono">
                <span class="text-amber-400 font-bold">PIKATILAT:</span>
                <button class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-cyan-500/40" @onclick='() => LaunchTestGame("wiring")'>🔌 Johdotus</button>
                <button class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-amber-300 border border-amber-500/40" @onclick='() => LaunchTestGame("troubleshooting")'>🔍 Vianetsintä</button>
                <button class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-emerald-300 border border-emerald-500/40" @onclick='() => LaunchTestGame("timing")'>⚡ Vaihetahdistus</button>
                <button class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700" @onclick="AddCash">+500 €</button>
                <button class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700" @onclick="() => SetStamina(100)">Täysi Stamina</button>
                <button class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-rose-300 border border-rose-500/40" @onclick="ResetDemoState">Nollaa Peli</button>
            </div>
        }

        <!-- Main Focused Workspace: Max 2 components visible at any time -->
        <main class="flex-1 p-4 lg:p-6 max-w-[1500px] w-full mx-auto">
            
            @if (activeViewTab == "workstation")
            {
                <!-- VIEW 1: WORKBENCH (Only Workstation + Financial/Stamina Sidebar) - 2 components -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
                    <div class="lg:col-span-8">
                        <ClickerWorkstation Player="state.Player"
                                            Upgrades="upgrades"
                                            OnAddCash="HandleAddCash"
                                            OnAddXp="HandleAddXp"
                                            OnAddRep="HandleAddRep"
                                            OnConsumeStamina="HandleConsumeStamina"
                                            OnLaunchMinigame="LaunchTestGame"
                                            OnRestToday="RestToday" />
                    </div>
                    <div class="lg:col-span-4">
                        <EarningsSidebar Player="state.Player"
                                         CurrentLoan="currentLoan"
                                         Upgrades="upgrades"
                                         OnRepayLoan="HandleRepayLoan" />
                    </div>
                </div>
            }
            else if (activeViewTab == "calendar")
            {
                <!-- VIEW 2: GIGS & CALENDAR (Calendar + Available Gigs Market) - 2 components -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
                    <div class="lg:col-span-7 flex flex-col gap-4">
                        <WeekCalendar Plan="weekPlan"
                                      CurrentDay="state.Player.DayOfWeek"
                                      AvailableGigs="availableGigs"
                                      SelectedGigToAssign="selectedGigToAssign"
                                      OnDaySelected="HandleDaySelected"
                                      OnExecuteDay="ExecuteDay"
                                      OnAssignGig="HandleAssignGig"
                                      OnClearSlot="HandleClearSlot"
                                      OnQuickAction="HandleQuickAction"
                                      OnCancelAssign="() => selectedGigToAssign = null" />

                        <!-- Simple Action Bar -->
                        <div class="luminous-panel p-3.5 flex items-center justify-between gap-3 text-xs">
                            <span class="text-slate-400 font-mono">Valitse keikka oikealta ja sijoita se kalenterin vapaalle päivälle.</span>
                            <div class="flex items-center gap-2">
                                <button class="px-3 py-1.5 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold transition-all"
                                        @onclick="() => ExecuteDay(state.Player.DayOfWeek)">
                                    ⚡ Suorita päivä (@state.Player.DayOfWeek)
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="lg:col-span-5">
                        <GigMarket Gigs="availableGigs"
                                   Player="state.Player"
                                   SelectedGig="selectedGigToAssign"
                                   OnSelectGig="HandleSelectGigFromMarket" />
                    </div>
                </div>
            }
            else if (activeViewTab == "upgrades")
            {
                <!-- VIEW 3: WORKSHOP UPGRADES (Focused view on tooling & automation) - 1 main component -->
                <div class="w-full">
                    <UpgradesBottomPanel Upgrades="upgrades"
                                         PlayerCash="state.Player.Cash"
                                         OnPurchaseUpgrade="HandlePurchaseUpgrade" />
                </div>
            }
            else if (activeViewTab == "company")
            {
                <!-- VIEW 4: COMPANY & BANK LOAN - 2 components: Company Status + Financial Sidebar -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
                    <div class="lg:col-span-8 flex flex-col gap-4">
                        <div class="luminous-panel luminous-panel-purple p-5 flex flex-col gap-4">
                            <div class="flex items-center justify-between border-b border-purple-500/20 pb-3">
                                <div class="flex items-center gap-3">
                                    <span class="text-2xl">🏢</span>
                                    <div>
                                        <h3 class="text-lg font-heading font-bold text-white">YRITYKSEN PÄÄMAJA & LIIKETOIMINTA</h3>
                                        <p class="text-xs font-mono text-purple-300">Siirtymä keikkatyöläisestä teollisuusautomaation suuryritykseksi</p>
                                    </div>
                                </div>
                                <span class="px-2.5 py-1 rounded bg-purple-500/20 text-purple-300 border border-purple-500/30 text-xs font-mono font-bold">
                                    @(state.Company != null ? state.Company.Name : "Tmi Sähkö & Automaatio (Perustettu)")
                                </span>
                            </div>

                            <!-- Narrative Callout: The Bank Loan Pressure -->
                            <div class="p-4 rounded-xl bg-gradient-to-r from-rose-950/40 to-slate-900 border border-rose-500/40 text-xs text-slate-300 space-y-2">
                                <div class="font-heading font-bold text-sm text-rose-300 flex items-center gap-2">
                                    <span>⚠️</span>
                                    <span>PANKKILAINA & KODIN KIINNITYS</span>
                                </div>
                                <p class="leading-relaxed">
                                    Liiketoiminnan ostaminen vaati 45 000 € pankkilainan, jonka vakuudeksi asetettiin perheen koti (arvo 180 000 €). 
                                    Jokainen työntekijä lisää kiinteitä palkkakustannuksia. Keikkojen viivästykset tai virheet kasvattavat konkurssin ja kodin menetyksen uhkaa.
                                </p>
                                <div class="flex items-center gap-4 text-mono font-bold text-xs pt-1">
                                    <span class="text-slate-400">Jäljellä oleva velka: <strong class="text-rose-400">@currentLoan.Principal.ToString("N0", new System.Globalization.CultureInfo("fi-FI")) €</strong></span>
                                    <span>•</span>
                                    <span class="text-slate-400">Kodin panttiaste: <strong class="text-amber-400">@Math.Round(currentLoan.CollateralRiskPercent, 1)%</strong></span>
                                </div>
                            </div>

                            <!-- Staff & Crew List -->
                            <div class="bg-slate-950/80 rounded-xl p-4 border border-slate-800 space-y-3">
                                <div class="flex items-center justify-between text-xs font-mono">
                                    <span class="text-slate-300 font-bold uppercase tracking-wider">PALKATTU HENKILÖSTÖ (@employees.Count kpl)</span>
                                    <span class="text-slate-400">Viikkopalkat yhteensä: <strong class="text-rose-400">-@(employees.Sum(e => e.WeeklyCostEur)) €/vk</strong></span>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                    @foreach (var emp in employees)
                                    {
                                        <div class="p-3 rounded-lg bg-slate-900/90 border border-slate-800 flex items-center justify-between">
                                            <div>
                                                <div class="font-heading font-bold text-white text-sm">@emp.Name</div>
                                                <div class="text-[11px] font-mono text-slate-400">Taitotaso: @emp.SkillLevel / 5 • Automaatio</div>
                                            </div>
                                            <div class="text-right font-mono text-xs">
                                                <div class="text-emerald-400 font-bold">+@(emp.SkillLevel * 30) €/pv tuotto</div>
                                                <div class="text-rose-400 text-[10px]">-@emp.WeeklyCostEur € / vk palkka</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="lg:col-span-4">
                        <EarningsSidebar Player="state.Player"
                                         CurrentLoan="currentLoan"
                                         Upgrades="upgrades"
                                         OnRepayLoan="HandleRepayLoan" />
                    </div>
                </div>
            }

        </main>
    </div>
}

@code {
