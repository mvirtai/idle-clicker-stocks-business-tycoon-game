    private System.Threading.Timer? passiveIncomeTimer;
    private readonly string[] DaysSequence = ["MA", "TI", "KE", "TO", "PE", "LA", "SU"];

    protected override void OnInitialized()
    {
        InitializeGame();

        // Passive Income Engine & In-game Day/Night Progression: runs every 1000ms
        passiveIncomeTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                double passiveRate = CalculateTotalPassiveRate();
                double added = passiveRate;
                double newCash = state.Player.Cash + added;
                double newLife = state.Player.LifetimeCash + added;

                int newMinute = state.Player.CurrentMinute + 2;
                int newHour = state.Player.CurrentHour;
                if (newMinute >= 60)
                {
                    newHour = (newHour + (newMinute / 60)) % 24;
                    newMinute %= 60;
                }

                state = state with
                {
                    Player = state.Player with
                    {
                        Cash = newCash,
                        LifetimeCash = newLife,
                        CurrentHour = newHour,
                        CurrentMinute = newMinute
                    }
                };

                try
                {
                    await JS.InvokeVoidAsync("ThemeManager.setTimeOfDay", newHour, newMinute);
                    var activeTheme = await JS.InvokeAsync<string>("ThemeManager.getTheme");
                    if (activeTheme != currentTheme)
                    {
                        currentTheme = activeTheme;
                    }
                }
                catch { }

                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

