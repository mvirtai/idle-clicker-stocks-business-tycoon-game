.comp-x1 { left: 40px; top: 60px; width: 180px; }
.comp-q1 { left: 250px; top: 30px; width: 170px; }
.comp-k1 { left: 450px; top: 30px; width: 210px; }
.comp-x2 { left: 690px; top: 60px; width: 220px; }

.component-header {
