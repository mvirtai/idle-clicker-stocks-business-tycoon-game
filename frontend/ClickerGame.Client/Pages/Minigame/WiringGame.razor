    align-items: center;
    gap: 0.45rem;
    flex: 1;
}

.check-box {
    font-size: 0.65rem;
    font-weight: 700;
    color: #94a3b8;
    min-width: 14px;
}

.item-done .check-box {
    color: #22c55e;
}

.wire-color-pip {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
    border: 1px solid #ffffff;
}

.rule-labels {
    display: flex;
    flex-direction: column;
}

.rule-main {
    font-size: 0.72rem;
    color: #f1f5f9;
    font-weight: 700;
}

.rule-detail {
    font-size: 0.62rem;
    color: #94a3b8;
}

.btn-item-action {
    font-size: 0.62rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 3px;
    cursor: pointer;
    border: 1px solid transparent;
}

.btn-item-connect {
    background: #0284c7;
    color: #ffffff;
    border-color: #38bdf8;
}

.btn-item-connect:hover {
    background: #0369a1;
}

.btn-item-remove {
    background: #7f1d1d;
    color: #fca5a5;
    border-color: #ef4444;
}

.palette-box {
    margin-top: auto;
    border-top: 1px solid var(--border-color);
    padding-top: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
}

.palette-title {
    font-size: 0.65rem;
    color: var(--text-muted);
}

.color-buttons {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
}

.color-btn {
    width: 28px;
    height: 28px;
    border-radius: 4px;
    border: 2px solid transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
}

.color-btn.color-active {
    border-color: #ffffff;
    box-shadow: 0 0 10px #ffffff;
    transform: scale(1.1);
}

.color-badge {
    font-size: 0.52rem;
    font-weight: 700;
    color: #ffffff;
    text-shadow: 0 1px 2px #000000;
}

.current-color-label {
    font-size: 0.68rem;
    color: var(--cyan-primary);
}

/* Cabinet Enclosure */
.cabinet-enclosure {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    position: relative;
    background: #0f141f;
    border: 3px solid #28354a;
}

/* Guide Action Bar */
.guide-action-bar {
    background: #111a2b;
    border: 1px solid #1e293b;
    border-radius: 4px;
    padding: 0.6rem 1rem;
    margin-bottom: 0.75rem;
}

.active-guide-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.75rem;
}

.guide-pulsing-badge {
    background: #eab308;
    color: #000000;
    font-weight: 900;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.65rem;
    animation: pulse 1.5s infinite;
}

.guide-step-text {
    color: #f1f5f9;
}

.guide-term {
    padding: 2px 5px;
    border-radius: 3px;
    font-weight: 700;
}

.from-term {
    background: rgba(0, 212, 255, 0.2);
    color: #00d4ff;
    border: 1px solid #00d4ff;
}

.to-term {
    background: rgba(245, 158, 11, 0.2);
    color: #f59e0b;
    border: 1px solid #f59e0b;
}

.guide-tip {
    color: var(--text-muted);
    font-size: 0.68rem;
    margin-left: auto;
}

/* Cabinet Canvas Container */
.cabinet-canvas-container {
    flex: 1;
    position: relative;
    background: #0a0e17;
    border: 2px inset #1e293b;
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}

.wires-svg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
    pointer-events: auto;
}

.cabinet-wire {
    cursor: pointer;
    transition: stroke-width 0.15s ease;
}

.cabinet-wire:hover {
    stroke-width: 9 !important;
    filter: drop-shadow(0 0 8px #ffffff);
}

.active-guide-path {
    animation: guideDash 1s linear infinite;
}

@@keyframes guideDash {
    to {
        stroke-dashoffset: -28;
    }
}

.beacon-circle {
    animation: beaconPulse 1.2s ease-out infinite;
    transform-origin: center;
}

.delay-beacon {
    animation-delay: 0.6s;
}

@@keyframes beaconPulse {
    0% { r: 10; opacity: 1; stroke-width: 3; }
    100% { r: 24; opacity: 0; stroke-width: 1; }
}

/* Fixed Precision DIN components positioning in 960x380 viewport */
