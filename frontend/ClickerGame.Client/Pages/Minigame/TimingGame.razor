@code {
    [Parameter]
    public Gig? CurrentGig { get; set; }

    [Parameter]
    public float PlayerStamina { get; set; } = 100f;

    [Parameter]
    public EventCallback<MinigameResult> OnComplete { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private ElementReference gameContainerRef;
    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;

    // Dial geometry
    private readonly double radius = 120.0;
    private double circumference => 2.0 * Math.PI * radius; // ~753.98
    private double currentAngle = 0.0;
    private double rotationSpeed = 1.85; // Smooth rhythmic cadence (~3.9s per full 360 deg)
    
    // Sector geometry
    private double sectorStartAngle = 180.0;
    private double sectorArcDegrees = 65.0;
    private double sectorArcLength => circumference * (sectorArcDegrees / 360.0);

    // Gameplay state: 24 cycles (3x longer than original 8)
    private int maxCycles = 24;
    private int completedCycles = 0;
    private int streak = 0;
    private List<(bool IsHit, double Accuracy, bool StreakBonus)> attemptResults = new();
    private bool isFlashHit = false;
    private bool isFlashMiss = false;
    private bool isGameOver = false;
    private MinigameResult? finalResult;
    private bool wasInsideSector = false;

    private int CurrentPhase
    {
        get
        {
            if (completedCycles < 8) return 1;
            if (completedCycles < 16) return 2;
            return 3;
        }
    }

    private string CurrentPhaseTitle => CurrentPhase switch
    {
        1 => "VAIHE 1/3: TAAJUUDEN KALIBROINTI",
        2 => "VAIHE 2/3: VAIHE-ERON TASAUS",
        _ => "VAIHE 3/3: KUORMITUKSEN KYTKENTÄ"
    };

    protected override void OnInitialized()
    {
        // Calculate sector width using the formula:
        // W(Stamina) = W_base * (0.5 + 0.5 * Stamina / 100) * beta_tool
        double baseArc = 75.0;
        double staminaFactor = 0.5 + 0.5 * (Math.Clamp(PlayerStamina, 5f, 100f) / 100.0);
        double betaTool = 1.0;
        sectorArcDegrees = baseArc * staminaFactor * betaTool;

        // Position target sector randomly in dial (e.g. 100 to 240 deg)
        var rng = new Random();
        sectorStartAngle = rng.Next(100, 240);

        StartGameLoop();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await gameContainerRef.FocusAsync();
            }
            catch { }
        }
    }

    private void StartGameLoop()
    {
        cts = new CancellationTokenSource();
        timer = new PeriodicTimer(TimeSpan.FromMilliseconds(20)); // ~50 FPS

        _ = Task.Run(async () =>
        {
            try
            {
                while (await timer.WaitForNextTickAsync(cts.Token))
                {
                    currentAngle = (currentAngle + rotationSpeed) % 360.0;

                    // Audio cue upon entering target sector
                    bool nowInside = IsInsideSector;
                    if (nowInside && !wasInsideSector)
                    {
                        wasInsideSector = true;
                        _ = JS.InvokeVoidAsync("GameAudio.playSectorEntry");
                    }
                    else if (!nowInside && wasInsideSector)
                    {
                        wasInsideSector = false;
                    }

                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (isGameOver) return;
        if (e.Code == "Space" || e.Key == " ")
        {
            await TriggerHit();
        }
    }

    private bool IsInsideSector => IsAngleInSector(currentAngle, sectorStartAngle, sectorArcDegrees, 0.0);

    private bool IsAngleInSector(double angle, double start, double arcDegrees, double tolerance = 6.0)
    {
        // Normalize angle and start to [0, 360)
        angle = (angle % 360.0 + 360.0) % 360.0;
        start = (start % 360.0 + 360.0) % 360.0;

        // Apply tolerance for reflex & input latency
        double effectiveStart = (start - tolerance + 360.0) % 360.0;
        double effectiveArc = arcDegrees + (2.0 * tolerance);

        if (effectiveArc >= 360.0) return true;

        double end = (effectiveStart + effectiveArc) % 360.0;

        if (effectiveStart < end)
        {
            return angle >= effectiveStart && angle <= end;
        }
        else
        {
            return angle >= effectiveStart || angle <= end;
        }
    }

    private double CalculateAccuracy(double angle, double start, double arcDegrees)
    {
        angle = (angle % 360.0 + 360.0) % 360.0;
        start = (start % 360.0 + 360.0) % 360.0;
        double center = (start + (arcDegrees / 2.0)) % 360.0;
        double diff = Math.Abs(angle - center);
        if (diff > 180.0) diff = 360.0 - diff;

        double maxDist = Math.Max(arcDegrees / 2.0, 1.0);
        double ratio = diff / maxDist;
        return Math.Clamp(1.0 - (ratio * 0.4), 0.6, 1.0) * 100.0;
    }

    private async Task TriggerHit()
    {
        if (isGameOver) return;

        // Check if current angle is inside target sector (with 8 deg tolerance for human reflex and event latency)
        bool isHit = IsAngleInSector(currentAngle, sectorStartAngle, sectorArcDegrees, 8.0);
        double accuracy = 0.0;

        if (isHit)
        {
            accuracy = CalculateAccuracy(currentAngle, sectorStartAngle, sectorArcDegrees);
            streak++;
            bool hadStreakBonus = streak >= 3;

            attemptResults.Add((true, accuracy, hadStreakBonus));
            
            // Audio Feedback
            try
            {
                if (hadStreakBonus)
                {
                    await JS.InvokeVoidAsync("GameAudio.playStreak");
                }
                else
                {
                    await JS.InvokeVoidAsync("GameAudio.playHit", streak);
                }
            }
            catch { }

            TriggerFlash(true);
        }
        else
        {
            streak = 0;
            attemptResults.Add((false, 0.0, false));
            try
            {
                await JS.InvokeVoidAsync("GameAudio.playMiss");
            }
            catch { }

            TriggerFlash(false);
        }

        completedCycles++;

        // Shift target sector smoothly for the next attempt
        var rng = new Random();
        sectorStartAngle = (sectorStartAngle + rng.Next(75, 150)) % 360.0;

        if (completedCycles >= maxCycles)
        {
            EndGame();
        }
    }

    private void TriggerFlash(bool hit)
    {
        if (hit)
        {
            isFlashHit = true;
            isFlashMiss = false;
        }
        else
        {
            isFlashMiss = true;
            isFlashHit = false;
        }

        _ = Task.Delay(250).ContinueWith(_ =>
        {
            isFlashHit = false;
            isFlashMiss = false;
            InvokeAsync(StateHasChanged);
        });
    }

    private void EndGame()
    {
        cts?.Cancel();
        isGameOver = true;

        // Calculate precision score
        int totalHits = attemptResults.Count(r => r.IsHit);
        double totalAccuracy = attemptResults.Where(r => r.IsHit).Sum(r => r.Accuracy);
        float precision = (float)(totalAccuracy / maxCycles);

        // Grade determination:
        // Perfect >= 85%
        // Good 55-84%
        // Fail < 55%
        string grade = precision >= 85f ? "perfect" : (precision >= 55f ? "good" : "fail");

        // Rewards calculation based on client gig (scaled for full 24-cycle shift)
        double basePay = CurrentGig != null ? (CurrentGig.PayMin + CurrentGig.PayMax) / 2.0 : 250.0;
        double payout = grade switch
        {
            "perfect" => basePay * 1.25,
            "good" => basePay,
            _ => basePay * 0.4
        };

        int xp = grade switch
        {
            "perfect" => 120,
            "good" => 70,
            _ => 25
        };

        int repDelta = grade switch
        {
            "perfect" => 6,
            "good" => 1,
            _ => -8
        };

        finalResult = new MinigameResult(precision, grade, xp, repDelta, payout);

        try
        {
            JS.InvokeVoidAsync("GameAudio.playSuccess");
        }
        catch { }

        StateHasChanged();
    }

    private async Task SubmitResult()
    {
        if (finalResult != null)
        {
            await OnComplete.InvokeAsync(finalResult);
        }
    }

    private async Task AbortGame()
    {
        cts?.Cancel();
        await OnCancel.InvokeAsync();
    }

    private string GetGradeStampClass() => $"stamp-{finalResult?.Grade.ToLower()}";

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
        timer?.Dispose();
    }
}
