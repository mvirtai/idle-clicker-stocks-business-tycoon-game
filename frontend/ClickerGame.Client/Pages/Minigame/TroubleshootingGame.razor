@namespace ClickerGame.Client.Pages.Minigame
@using ClickerGame.Client.Models
@inject IJSRuntime JS

<div class="troubleshooting-game-screen" tabindex="0" @ref="gameContainerRef" @onkeydown="HandleKeyDown">
    <!-- Top HUD Bar -->
    <header class="game-hud-bar">
        <div class="hud-left">
            <span class="hud-tag font-mono">VIANETSINTÄ // NOPEA HUOLTOKEIKKA</span>
            <h2 class="hud-title font-heading">
                @(CurrentGig != null ? $"{CurrentGig.ClientName} // VIANETSINTÄ" : "AUTOMAATIOLINJAN VIANETSINTÄ")
            </h2>
        </div>

        <div class="hud-center">
            <div class="hud-pill font-mono">
                <span class="label">STAMINA:</span>
                <span class="val text-cyan">@Math.Round(PlayerStamina, 0)%</span>
            </div>
            <div class="hud-pill font-mono">
                <span class="label">MITTAUKSET:</span>
                <span class="val text-amber">@measurementsTaken kpl</span>
            </div>
            <div class="hud-pill font-mono">
                <span class="label">TILANNE:</span>
                <span class="val @(isSolved ? "text-green" : "text-danger")">
                    @(isSolved ? "✔ VIKA KORJATTU" : "⚠ HÄLYTYS PÄÄLLÄ")
                </span>
            </div>
        </div>

        <div class="hud-right">
            <button class="btn-industrial btn-sm btn-tutorial-trigger" @onclick="OpenTutorial">❓ OPAS</button>
            <button class="btn-industrial btn-sm btn-abort" @onclick="AbortGame">✕ KESKEYTÄ</button>
        </div>
    </header>

    <!-- Keyboard Hotkey Shortcut Banner (Näppäinohjaus) -->
    <div class="quick-hotkey-strip font-mono">
        <span class="hotkey-tip-title">⚡ NÄPPÄINOIKOTIET:</span>
        <span class="hotkey-pill" @onclick="AutofindFault" title="Automaattinen nopea diagnostiikka"><kbd>SPACE</kbd> = Nopea diagnoosi</span>
        <span class="hotkey-pill" @onclick='() => AttemptFix("FUSE")' title="Vaihda sulake"><kbd>1</kbd> Sulake F1</span>
        <span class="hotkey-pill" @onclick='() => AttemptFix("ESTOP")' title="Vapauta Hätä-seis"><kbd>2</kbd> Hätä-seis S0</span>
        <span class="hotkey-pill" @onclick='() => AttemptFix("THERMAL")' title="Kuittaa lämpörele"><kbd>3</kbd> Lämpörele F2</span>
        <span class="hotkey-pill" @onclick='() => AttemptFix("PSU")' title="Vaihda teholähde"><kbd>4</kbd> Teholähde</span>
        <span class="hotkey-pill" @onclick='() => AttemptFix("CONTACTOR")' title="Vaihda kontaktori"><kbd>5</kbd> Kontaktori K1</span>
    </div>

    <!-- Paused Tutorial Modal Overlay -->
    @if (showTutorial)
    {
        <div class="tutorial-modal-backdrop">
            <div class="tutorial-modal-card industrial-card">
                <div class="tutorial-header">
                    <div class="tutorial-badge font-mono">PIKAOPAS // @(tutorialStep + 1) / 2</div>
                    <h3 class="tutorial-title font-heading">@GetTutorialStepTitle(tutorialStep)</h3>
                    <button class="btn-close-tut" @onclick="CloseTutorial" title="Sulje tutoriaali">✕</button>
                </div>

                <div class="tutorial-step-tabs font-mono">
                    <button class="step-tab @(tutorialStep == 0 ? "tab-active" : "")" @onclick="() => tutorialStep = 0">
                        1. HELPPO VIANHAKU
                    </button>
                    <button class="step-tab @(tutorialStep == 1 ? "tab-active" : "")" @onclick="() => tutorialStep = 1">
                        2. KORJAUS & NÄPPÄIMET
                    </button>
                </div>

                <div class="tutorial-content-body font-mono">
                    @if (tutorialStep == 0)
                    {
                        <div class="tut-slide">
                            <div class="tut-fun-banner">
                                <span class="fun-emoji">🔍</span>
                                <div class="fun-text">
                                    <strong>Rentoudu! Sinun ei tarvitse laskea ohmeja tai jännitteitä.</strong>
                                    <span>Lue asiakkaan ilmoitus tai paina <kbd>SPACE</kbd> ajaaksesi nopean diagnoosin!</span>
                                </div>
                            </div>

                            <div class="tut-instruction-split">
                                <div class="tut-box tut-box-visual">
                                    <h4 class="box-title text-cyan">TAPA 1: NOPEA DIAGNOOSI (PIKA)</h4>
                                    <p class="box-tip">
                                        Paina <kbd class="kbd-lg">SPACE</kbd>! Peli testaa automaattisesti piirin ja kertoo suoraan mikä osa on vialla.
                                    </p>
                                    <div class="easy-badge">⚡ Paina vain näppäimiä 1, 2, 3, 4 tai 5 korjataksesi!</div>
                                </div>

                                <div class="tut-box tut-box-button">
                                    <h4 class="box-title text-green">TAPA 2: KLIKKAA KAAVIOSTA</h4>
                                    <p class="box-tip">
                                        Klikkaa kaavion testipisteitä (TP1, TP2, TP3...) ja katso yleismittarista missä jännite katkeaa.
                                    </p>
                                    <div class="easy-badge">👆 Kivaa mittailua ilman kiirettä!</div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="tut-slide">
                            <p class="tut-intro-text">
                                Korjaa vika valitsemalla toimenpide alta tai painamalla numeroa:
                            </p>

                            <div class="fix-examples-list">
                                <div class="fix-example-item">
                                    <span class="hotkey-pill" style="margin:0;"><kbd>1</kbd></span>
                                    <span class="fix-tag text-amber">Sulake F1:</span>
                                    <span>Moottori ei pyöri, pääsyötön sulake palanut</span>
                                </div>
                                <div class="fix-example-item">
                                    <span class="hotkey-pill" style="margin:0;"><kbd>2</kbd></span>
                                    <span class="fix-tag text-cyan">Hätä-Seis S0:</span>
                                    <span>Joku painoi punaista nappia, vapauta kääntämällä</span>
                                </div>
                                <div class="fix-example-item">
                                    <span class="hotkey-pill" style="margin:0;"><kbd>3</kbd></span>
                                    <span class="fix-tag text-green">Lämpörele F2:</span>
                                    <span>Pumppu kuumeni ja pysähtyi, kuittaa (Reset)</span>
                                </div>
                                <div class="fix-example-item">
                                    <span class="hotkey-pill" style="margin:0;"><kbd>4</kbd></span>
                                    <span class="fix-tag text-cyan">Teholähde:</span>
                                    <span>24V ohjaussähkö pimeänä, vaihda uusi</span>
                                </div>
                                <div class="fix-example-item">
                                    <span class="hotkey-pill" style="margin:0;"><kbd>5</kbd></span>
                                    <span class="fix-tag text-amber">Kontaktori K1:</span>
                                    <span>Ohjauskela rikki, kontaktori ei vedä päälle</span>
                                </div>
                            </div>

                            <div class="ready-cta-box" style="margin-top: 0.8rem;">
                                <span class="ready-title">VALMIINA HUOLTAJANA?</span>
                                <span class="ready-sub">Paina <kbd>SPACE</kbd> ja aloita vianetsintä!</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="tutorial-footer">
                    <div class="tut-foot-left">
                        @if (tutorialStep > 0)
                        {
                            <button class="btn-industrial btn-sm" @onclick="PrevTutorialStep">
                                ◀ EDELLINEN
                            </button>
                        }
                    </div>

                    <div class="tut-foot-dots">
                        @for (int s = 0; s < 2; s++)
                        {
                            var stepIdx = s;
                            <span class="tut-dot @(tutorialStep == stepIdx ? "dot-active" : "")" 
                                  @onclick="() => tutorialStep = stepIdx"></span>
                        }
                    </div>

                    <div class="tut-foot-right">
                        @if (tutorialStep < 1)
                        {
                            <button class="btn-industrial btn-industrial-cyan btn-sm" @onclick="NextTutorialStep">
                                SEURAAVA SIVU ▶
                            </button>
                        }
                        else
                        {
                            <button class="btn-industrial btn-industrial-cyan btn-lg font-bold" @onclick="CloseTutorial">
                                🎮 ALOITA KEIKKA (SPACE)!
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Main Workspace -->
    <main class="troubleshoot-stage">
        <!-- Left: Digital Multimeter (Fluke-tyylinen yleismittari) -->
        <section class="multimeter-panel industrial-card">
            <div class="multimeter-body">
                <div class="multimeter-brand font-heading">NORDIC METEX // PRO-6000</div>
                <div class="multimeter-sub font-mono">TRUE RMS CAT IV 600V</div>

                <!-- Digital LCD Screen -->
                <div class="dmm-screen font-mono">
                    <div class="screen-header">
                        <span class="screen-mode">@currentMode</span>
                        <span class="screen-hold">AUTO</span>
                    </div>
                    <div class="screen-value">
                        @displayValue
                    </div>
                    <div class="screen-unit">
                        @displayUnit
                    </div>
                </div>

                <!-- Rotary Dial Mode Selector -->
                <div class="rotary-dial-container">
                    <span class="dial-label dial-off @(currentMode == "OFF" ? "active" : "")">OFF</span>
                    <span class="dial-label dial-vac @(currentMode == "V AC" ? "active" : "")">V~</span>
                    <span class="dial-label dial-vdc @(currentMode == "V DC" ? "active" : "")">V⎓</span>
                    <span class="dial-label dial-ohm @(currentMode == "OHM" ? "active" : "")">Ω</span>
                    <span class="dial-label dial-cont @(currentMode == "CONT" ? "active" : "")">🔊</span>

                    <div class="rotary-knob @GetKnobClass()" @onclick="CycleMode">
                        <div class="knob-marker"></div>
                    </div>
                </div>

                <!-- Probe Leads Jack -->
                <div class="probe-jacks">
                    <div class="jack-col">
                        <div class="jack jack-com"></div>
                        <span class="jack-label font-mono">COM (MUSTA)</span>
                    </div>
                    <div class="jack-col">
                        <div class="jack jack-v"></div>
                        <span class="jack-label font-mono">V / Ω (PUN)</span>
                    </div>
                </div>

                <div class="probes-status font-mono">
                    <div>PUNAINEN (+): <span class="text-amber">@(redProbePoint ?? "IRTI")</span></div>
                    <div>MUSTA (COM): <span class="text-cyan">@(blackProbePoint ?? "IRTI")</span></div>
                </div>
            </div>
        </section>

        <!-- Center: Interactive Circuit Schematic & Test Points (Kytkentäkaavio ja mittapisteet) -->
        <section class="schematic-view industrial-card">
            <div class="schematic-header">
                <div>
                    <span class="led-indicator @(isSolved ? "led-green" : "led-red")"></span>
                    <span class="font-heading title">VIANMÄÄRITYSKAAVIO #PUMP-AUTO</span>
                </div>
                <div class="fault-brief font-mono">
                    VIKAILMOITUS: <span class="text-amber font-bold">"@currentFault.CustomerReport"</span>
                </div>
            </div>

            <!-- Quick Guidance Banner -->
            <div class="troubleshoot-guide-banner font-mono">
                <span class="guide-icon">💡</span>
                <span class="guide-text">
                    <strong>OHJE:</strong> Klikkaa vasemmalta mittarin mustaa kiekkoa vaihtaaksesi mittaustilaa (V~ / V⎓ / Ω). Klikkaa kaaviosta testipisteitä (esim. musta mittapää <strong>PE-MAA</strong> ja punainen mittapää <strong>TP1, TP2...</strong>). Paikanna katkos ja valitse alta oikea korjaustoimenpide!
                </span>
            </div>

            <!-- Interactive Schematic Canvas -->
            <div class="schematic-circuit font-mono">
                <!-- Circuit Row 1: 400V Päävirtapiiri -->
                <div class="circuit-section">
                    <span class="section-title">400V VAIHTOVIRTASYÖTTÖ JA MOOTTORIPIIRI</span>
                    <div class="circuit-chain">
                        <!-- Node 1: Syöttö TP1 -->
                        <div class="circuit-node">
                            <button class="test-point-btn @GetTpClass("TP1")" @onclick='() => ProbePoint("TP1")'>TP1</button>
                            <span class="node-label">SYÖTTÖ 400V</span>
                        </div>
                        <div class="circuit-line"></div>

                        <!-- Component: Pääkytkin Q0 -->
                        <div class="circuit-component">
                            <span class="comp-icon">⏻</span>
                            <span class="comp-name">PÄÄKYTKIN Q0</span>
                        </div>
                        <div class="circuit-line"></div>

                        <!-- Node 2: TP2 -->
                        <div class="circuit-node">
                            <button class="test-point-btn @GetTpClass("TP2")" @onclick='() => ProbePoint("TP2")'>TP2</button>
                            <span class="node-label">Q0 LÄHTÖ</span>
                        </div>
                        <div class="circuit-line"></div>

                        <!-- Component: Sulakkeet F1 -->
                        <div class="circuit-component @(currentFault.FaultType == "FUSE" ? "comp-faulty" : "")">
                            <span class="comp-icon">▯</span>
                            <span class="comp-name">SULAKKEET F1</span>
                        </div>
                        <div class="circuit-line"></div>

                        <!-- Node 3: TP3 -->
                        <div class="circuit-node">
                            <button class="test-point-btn @GetTpClass("TP3")" @onclick='() => ProbePoint("TP3")'>TP3</button>
                            <span class="node-label">F1 JÄLKEEN</span>
                        </div>
                        <div class="circuit-line"></div>

                        <!-- Component: Kontaktori K1 -->
                        <div class="circuit-component @(currentFault.FaultType == "CONTACTOR" ? "comp-faulty" : "")">
                            <span class="comp-icon">⚯</span>
                            <span class="comp-name">KONTAKTORI K1</span>
                        </div>
                        <div class="circuit-line"></div>

                        <!-- Node 4: TP4 -->
                        <div class="circuit-node">
                            <button class="test-point-btn @GetTpClass("TP4")" @onclick='() => ProbePoint("TP4")'>TP4</button>
                            <span class="node-label">MOOTTORI M1</span>
                        </div>
                    </div>
                </div>

                <!-- Circuit Row 2: 24V DC Ohjausvirtapiiri -->
                <div class="circuit-section">
                    <span class="section-title">24V DC OHJAUS- JA TURVAVIRTAPIIRI</span>
                    <div class="circuit-chain">
                        <!-- Node 5: 24V Teholähde TP5 -->
                        <div class="circuit-node">
                            <button class="test-point-btn @GetTpClass("TP5")" @onclick='() => ProbePoint("TP5")'>TP5</button>
                            <span class="node-label">+24V SYÖTTÖ</span>
                        </div>
                        <div class="circuit-line"></div>

                        <!-- Component: Hätä-Seis S0 -->
                        <div class="circuit-component @(currentFault.FaultType == "ESTOP" ? "comp-faulty" : "")">
                            <span class="comp-icon">🛑</span>
                            <span class="comp-name">HÄTÄ-SEIS S0</span>
                        </div>
                        <div class="circuit-line"></div>

                        <!-- Node 6: TP6 -->
                        <div class="circuit-node">
                            <button class="test-point-btn @GetTpClass("TP6")" @onclick='() => ProbePoint("TP6")'>TP6</button>
                            <span class="node-label">S0 LÄHTÖ</span>
                        </div>
                        <div class="circuit-line"></div>

                        <!-- Component: Lämpörele F2 (95-96) -->
                        <div class="circuit-component @(currentFault.FaultType == "THERMAL" ? "comp-faulty" : "")">
                            <span class="comp-icon">⚡</span>
                            <span class="comp-name">LÄMPÖRELE F2</span>
                        </div>
                        <div class="circuit-line"></div>

                        <!-- Node 7: TP7 -->
                        <div class="circuit-node">
                            <button class="test-point-btn @GetTpClass("TP7")" @onclick='() => ProbePoint("TP7")'>TP7</button>
                            <span class="node-label">F2 LÄHTÖ</span>
                        </div>
                        <div class="circuit-line"></div>

                        <!-- Component: Käynnistys S1 & Kontaktori Kela -->
                        <div class="circuit-component">
                            <span class="comp-icon">🎛</span>
                            <span class="comp-name">KELA K1 (A1-A2)</span>
                        </div>
                        <div class="circuit-line"></div>

                        <!-- Node 8: 0V Nolla TP8 -->
                        <div class="circuit-node">
                            <button class="test-point-btn @GetTpClass("TP8")" @onclick='() => ProbePoint("TP8")'>TP8</button>
                            <span class="node-label">0V / GND</span>
                        </div>
                    </div>
                </div>

                <!-- Ground bar -->
                <div class="ground-bar">
                    <button class="test-point-btn term-pe @GetTpClass("GND")" @onclick='() => ProbePoint("GND")'>PE-MAA</button>
                    <span class="font-mono text-muted">SUOJAMAA (POTENTIAALINTASAUS)</span>
                </div>
            </div>

            <!-- Action / Diagnostic Repair Panel -->
            <div class="repair-decision-box font-mono">
                <div class="decision-header">
                    <span class="title font-heading">KORJAUSTOIMENPIDE (VALITSE VIAN MUKAAN):</span>
                    <span class="hint text-muted">Mittaa ensin yleismittarilla, varmista katkoskohta ja tee korjaus:</span>
                </div>

                <div class="fix-options">
                    <button class="btn-industrial btn-sm" @onclick='() => AttemptFix("FUSE")'>
                        🔧 Vaihda palanut sulake F1
                    </button>
                    <button class="btn-industrial btn-sm" @onclick='() => AttemptFix("ESTOP")'>
                        🛑 Vapauta jumittunut hätä-seis S0
                    </button>
                    <button class="btn-industrial btn-sm" @onclick='() => AttemptFix("THERMAL")'>
                        ⚡ Kuittaa lauennut lämpörele F2
                    </button>
                    <button class="btn-industrial btn-sm" @onclick='() => AttemptFix("PSU")'>
                        🔌 Vaihda viallinen 24VDC teholähde
                    </button>
                    <button class="btn-industrial btn-sm" @onclick='() => AttemptFix("CONTACTOR")'>
                        ⚙ Vaihda viallinen kontaktori K1
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(actionFeedback))
                {
                    <div class="action-feedback font-mono @(isSolved ? "text-green" : "text-danger")">
                        @actionFeedback
                    </div>
                }
            </div>
        </section>
    </main>

    <!-- Loppupöytäkirja Modal -->
    @if (isGameOver && finalResult != null)
    {
        <div class="result-modal-backdrop">
            <div class="industrial-card result-report-card">
                <div class="report-header">
                    <div class="stamp-badge stamp-@finalResult.Grade.ToLower()">@finalResult.Grade.ToUpper()</div>
                    <h3 class="report-title font-heading">VIANHAKU- JA HUOLTOPÖYTÄKIRJA</h3>
                    <span class="report-sub font-mono">DIAGNOSTIIKKA JA KORJAUSTOIMENPITEET SUORITETTU</span>
                </div>

                <div class="report-body font-mono">
                    <div class="report-stat-row">
                        <span>LÖYDETTY VIKA:</span>
                        <span class="text-cyan font-bold">@currentFault.FaultTitle</span>
                    </div>
                    <div class="report-stat-row">
                        <span>MITTAUKSIA KÄYTETTY:</span>
                        <span>@measurementsTaken kpl</span>
                    </div>
                    <div class="report-stat-row">
                        <span>TURHAT VARAOSAVAIHDOT:</span>
                        <span>@wrongFixCount kpl</span>
                    </div>
                    <div class="report-stat-row">
                        <span>URAKKAPALKKIO:</span>
                        <span class="text-green font-bold">+@finalResult.PayEur.ToString("0") €</span>
                    </div>
                    <div class="report-stat-row">
                        <span>KOKEMUSPISTEET:</span>
                        <span class="text-amber font-bold">+@finalResult.XpGained XP</span>
                    </div>
                    <div class="report-stat-row">
                        <span>MAINEVAIKUTUS:</span>
                        <span class="font-bold @(finalResult.RepDelta >= 0 ? "text-green" : "text-danger")">
                            @(finalResult.RepDelta >= 0 ? $"+{finalResult.RepDelta}" : finalResult.RepDelta.ToString()) MAINETTA
                        </span>
                    </div>
                </div>

                <div class="report-actions">
                    <button class="btn-industrial btn-industrial-cyan btn-lg" @onclick="SubmitResult">
                        ✔ HYVÄKSY JA PALAA KALENTERIIN
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
.troubleshooting-game-screen {
    position: fixed;
    inset: 0;
    background-color: #080b11;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    user-select: none;
}

.troubleshoot-stage {
    flex: 1;
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 1.25rem;
    padding: 1.25rem;
    overflow: hidden;
}

/* Digital Multimeter Body */
.multimeter-panel {
    background: #eab308;
    border: 4px solid #ca8a04;
    border-radius: 16px;
    padding: 1.25rem;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.7), inset 0 2px 0 rgba(255, 255, 255, 0.4);
    display: flex;
    flex-direction: column;
}

.multimeter-body {
    background: #1e293b;
    border-radius: 10px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    flex: 1;
}

.multimeter-brand {
    font-size: 0.85rem;
    font-weight: 800;
    color: #f1f5f9;
    letter-spacing: 0.08em;
}

.multimeter-sub {
    font-size: 0.55rem;
    color: #94a3b8;
    margin-top: -0.6rem;
}

/* DMM Screen */
.dmm-screen {
    width: 100%;
    height: 90px;
    background: #a3e635;
    border: 3px inset #65a30d;
    border-radius: 4px;
    padding: 0.4rem 0.6rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.3);
}

.screen-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.65rem;
    color: #14532d;
    font-weight: 700;
}

.screen-value {
    font-size: 2.2rem;
    font-weight: 900;
    color: #052e16;
    text-align: right;
    line-height: 1;
    letter-spacing: -0.05em;
}

.screen-unit {
    font-size: 0.75rem;
    color: #14532d;
    text-align: right;
    font-weight: 700;
}

/* Rotary Dial */
.rotary-dial-container {
    width: 130px;
    height: 130px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.dial-label {
    position: absolute;
    font-size: 0.65rem;
    font-weight: 700;
    color: #64748b;
    font-family: var(--font-mono);
}

.dial-label.active {
    color: #f59e0b;
    text-shadow: 0 0 8px #f59e0b;
}

.dial-off { top: 0px; left: 52px; }
.dial-vac { top: 22px; right: 8px; }
.dial-vdc { bottom: 22px; right: 8px; }
.dial-ohm { bottom: 0px; left: 52px; }
.dial-cont { bottom: 22px; left: 8px; }

.rotary-knob {
    width: 70px;
    height: 70px;
    background: radial-gradient(circle, #334155 0%, #0f172a 100%);
    border: 3px solid #64748b;
    border-radius: 50%;
    cursor: pointer;
    position: relative;
    transition: transform 0.2s ease;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.6);
}

.knob-marker {
    position: absolute;
    top: 4px;
    left: 31px;
    width: 4px;
    height: 18px;
