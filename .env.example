PORT=3000
NODE_ENV=development

# Firebase & Google OAuth (Valinnainen: tarvitaan vain Google Slides Pitch Deck -vientiin)
# Kopioi tämä tiedosto nimelle .env ja täytä omat arvosi. Älä koskaan commitoi oikeita avaimia Gitiin!
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_GOOGLE_OAUTH_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
