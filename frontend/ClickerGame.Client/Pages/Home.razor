    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("ThemeManager.setTimeOfDay", state.Player.CurrentHour, state.Player.CurrentMinute);
                currentTheme = await JS.InvokeAsync<string>("ThemeManager.getTheme");
                StateHasChanged();
            }
            catch { }
        }
    }

